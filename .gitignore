# Build outputs
dist/
target/

# Tool crates are root-workspace members; the root Cargo.lock is authoritative.
tools/*/Cargo.lock

# IDE/Editor
# Shared VS Code debug/build config is tracked; user-specific state is not.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Environment/secrets
.env
.env.local
.env.*.local
*.env

# Logs
*.log
debug-logs/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp
.tmp-*
nul
_tmp/

# Local editor and agent tool state
.claude/
.codex/
.mcp.json
.omc/
.omo/
.omx/

# Root config files (user-specific)
settings.json
sounds.json
# ...but the shared VS Code workspace settings are tracked (the bare
# `settings.json` pattern above matches at any depth, including .vscode/).
!.vscode/settings.json

# Python bytecode (bench scripts)
__pycache__/
*.pyc

# PGO profile intermediates
*.profraw
*.profdata

# Local benchmark output (scripts/bench writes runs here by default)
benchmarks/results/

# Profiling artifacts
echo_trace.json
flamegraph.svg
perf.data
perf.data.old
perf-report.txt
valgrind.log
strace-summary.txt
cachegrind.out.*
heaptrack.echo.*
massif.out.*
vgcore.*

# Local app runtime data
user_notes.json
