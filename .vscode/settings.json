{
  // Keep rust-analyzer's builds out of ./target so it does not hold the cargo
  // build lock while `cargo run` / the debugger are building.
  "rust-analyzer.cargo.targetDir": true,
  // Check with clippy, like the `cargo lint` gate (the "cargo: lint" task).
  "rust-analyzer.check.command": "clippy",
  // The root crate's GPUI test target overflows rustc's stack on Windows, so
  // rust-analyzer must not build test targets.
  "rust-analyzer.check.allTargets": false
}
