# Auto-detect text files and normalize line endings to LF in repo
* text=auto

# Format-patch files encode diff syntax where added blank lines and the standard
# `-- ` mail signature separator intentionally end in spaces. Do not report
# those payload lines as repository whitespace errors.
*.patch whitespace=-blank-at-eof,-blank-at-eol

# Keep Markdown, docs and their fixtures, scripts, CI workflows and benchmark
# fixtures LF in every checkout, so Windows and Linux see the same bytes. Shell
# scripts must stay LF to run on Linux.
*.md text eol=lf
docs/** text=auto eol=lf
scripts/** text=auto eol=lf
benchmarks/** text=auto eol=lf
.github/** text=auto eol=lf
Makefile text eol=lf
