     /// Clear per-frame state and push the root node to start a new frame.
+    ///
+    /// The previous frame's per-node state is kept aside until the frame ends,
+    /// for [`Self::reuse_nodes`].
     pub(crate) fn begin_frame(&mut self) {
+        mem::swap(&mut self.focus_ids, &mut self.rendered.focus_ids);
+        mem::swap(&mut self.node_bounds, &mut self.rendered.node_bounds);
+        mem::swap(
+            &mut self.action_listeners,
+            &mut self.rendered.action_listeners,
+        );
         self.focus_ids.clear();
         self.node_bounds.clear();
         self.action_listeners.clear();
         self.nodes.begin_frame(self.window_title.as_ref());
     }
 
+    /// Whether the previous frame built a tree that reused cached views can
+    /// replay their nodes from. When it didn't (accessibility was inactive),
+    /// every view has to render this frame.
+    pub(crate) fn can_reuse_nodes(&self) -> bool {
+        self.nodes.has_finished_frame()
+    }
+
+    /// Drops the tree kept from the last frame that built one. Called for every
+    /// frame drawn while accessibility is inactive, so an inactive window keeps
+    /// no copy of the tree.
+    pub(crate) fn release_finished_frame(&mut self) {
+        self.nodes.release_finished_frame();
+    }
+
+    /// Replays the accessibility state that a cached view's subtree recorded in
+    /// `range` of the previous frame, for a view whose prepaint is reused.
+    ///
+    /// The view's nodes are re-attached under the current parent (see
+    /// [`A11yNodeBuilder::replay`]), and their bounds, focus handles and action
+    /// listeners move over from the previous frame. Action listeners are boxed
+    /// closures that can't be cloned, so they are moved like the reused
+    /// view's mouse listeners; a reused view's paint is reused too and never
+    /// registers them again. The view's focused node and active descendant are
+    /// restored when they still apply, because the elements that report them
+    /// during prepaint are skipped. `window_focus` is the window's focus.
+    pub(crate) fn reuse_nodes(
+        &mut self,
+        range: Range<A11yNodeIndex>,
+        window_focus: Option<FocusId>,
+    ) {
+        let replayed = self.nodes.replay(range);
+        let rendered_focus = self.nodes.rendered.focus;
+        let rendered_active_descendant = self.nodes.rendered.active_descendant;
+        let mut replayed_focus = None;
+        let mut replayed_active_descendant = None;
+        for (id, _) in &self.nodes.all_nodes[replayed] {
+            if let Some(bounds) = self.rendered.node_bounds.get(id) {
+                self.node_bounds.insert(*id, *bounds);
+            }
+            if let Some(focus_id) = self.rendered.focus_ids.get(id) {
+                self.focus_ids.insert(*id, *focus_id);
+            }
+            if let Some(listeners) = self.rendered.action_listeners.remove(id) {
+                self.action_listeners.insert(*id, listeners);
+            }
+            if rendered_focus == Some(*id) {
+                replayed_focus = Some(*id);
+            }
+            if rendered_active_descendant == Some(*id) {
+                replayed_active_descendant = Some(*id);
+            }
+        }
+
+        // As in `Interactivity::prepaint`: the node is focused while its focus
+        // handle is the window's focus.
+        if let Some(node_id) = replayed_focus
+            && window_focus.is_some()
+            && self.focus_ids.get(&node_id).copied() == window_focus
+        {
+            self.set_focus(node_id);
+        }
+
+        // An active descendant only counts while the focused node is one of its
+        // ancestors. A focused node outside the view is an ancestor exactly when
+        // it's on the stack; inside the view, the subtree is unchanged, so the
+        // node that was focused when the claim was made still qualifies.
+        if let Some(node_id) = replayed_active_descendant
+            && let Some(focus) = self.nodes.focus
+            && focus != node_id
+            && (replayed_focus == Some(focus) || self.nodes.ids_stack.contains(&focus))
+        {
+            self.nodes.set_active_descendant(node_id);
+        }
+    }
+
