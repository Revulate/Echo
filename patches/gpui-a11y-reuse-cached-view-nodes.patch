+    /// The current position, for [`Self::replay`] in the next frame.
+    pub(crate) fn index(&self) -> A11yNodeIndex {
+        A11yNodeIndex {
+            nodes: self.all_nodes.len(),
+            depth: self.ids_stack.len(),
+        }
+    }
+
+    /// Whether `all_nodes` holds a finished frame (which always contains the
+    /// root) for the next frame to replay from.
+    fn has_finished_frame(&self) -> bool {
+        !self.all_nodes.is_empty()
+    }
+
+    fn release_finished_frame(&mut self) {
+        if self.all_nodes.capacity() == 0 && self.rendered.nodes.capacity() == 0 {
+            return;
+        }
+        self.all_nodes = Vec::new();
+        self.parent_depths = Vec::new();
+        self.rendered = RenderedNodes::default();
+        #[cfg(debug_assertions)]
+        self.node_info.clear();
+    }
+
+    /// Replays the nodes that a cached view's subtree finished in `range` of the
+    /// previous frame, and returns where they landed in `all_nodes`.
+    ///
+    /// Every node a subtree pushes is popped before its prepaint returns, so its
+    /// finished nodes are contiguous, and their child lists only name nodes of
+    /// the same subtree. The nodes are therefore moved over unchanged, except
+    /// that the ones that were children of the subtree's parent (stack depth
+    /// `range.start.depth`) become children of the current parent. A node
+    /// whose id is already in this frame's tree is dropped, as [`Self::push`]
+    /// would drop it.
+    pub(crate) fn replay(&mut self, range: Range<A11yNodeIndex>) -> Range<usize> {
+        let start = self.all_nodes.len();
+        let source = range.start.nodes..range.end.nodes;
+        if source.is_empty() || source.end > self.rendered.nodes.len() {
+            return start..start;
+        }
+        let base_depth = range.start.depth;
+        let depth = self.ids_stack.len();
+        for ix in source {
+            let parent_depth = self.rendered.parent_depths[ix];
+            let id = self.rendered.nodes[ix].0;
+            if !self.can_push(id) {
+                continue;
+            }
+            let node = mem::take(&mut self.rendered.nodes[ix].1);
+            if parent_depth == base_depth
+                && let Some(parent) = self.nodes_stack.last_mut()
+            {
+                parent.push_child(id);
+            }
+            self.all_nodes.push((id, node));
+            self.parent_depths
+                .push(depth + parent_depth.saturating_sub(base_depth));
+            #[cfg(debug_assertions)]
+            if let Some(info) = self.rendered.node_info.remove(&id) {
+                self.node_info.insert(id, info);
+            }
+        }
+        start..self.all_nodes.len()
+    }
