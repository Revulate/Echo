+    // Bounds, focus registration, action listeners and the focused node of a
+    // reused view survive the frame, and a frame that doesn't reuse the view
+    // drops them.
+    #[test]
+    fn reused_subtree_keeps_its_focus_bounds_and_action_listeners() {
+        let view = NodeId(2);
+        let focus_id = FocusId::default();
+        let mut a11y = new_a11y();
+        let start = a11y.nodes.index();
+        assert!(a11y.nodes.push(view, test_node()));
+        a11y.node_bounds.insert(view, Default::default());
+        a11y.set_focusable(view, focus_id);
+        a11y.set_focus(view);
+        let listener: A11yActionListener = Box::new(|_, _, _| {});
+        a11y.action_listeners
+            .entry(view)
+            .or_default()
+            .push((accesskit::Action::Click, listener));
+        a11y.nodes.pop();
+        let range = start..a11y.nodes.index();
+        assert_eq!(a11y.end_frame(Default::default()).focus, view);
+
+        a11y.begin_frame();
+        a11y.reuse_nodes(range, Some(focus_id));
+        let update = a11y.end_frame(Default::default());
+        assert_eq!(update.focus, view);
+        assert_eq!(node_children(&update, ROOT_NODE_ID), Some(vec![view]));
+        assert!(a11y.node_bounds.contains_key(&view));
+        assert_eq!(a11y.focus_ids.get(&view), Some(&focus_id));
+        assert_eq!(a11y.action_listeners.get(&view).map(Vec::len), Some(1));
+
+        a11y.begin_frame();
+        let update = a11y.end_frame(Default::default());
+        assert_eq!(update.focus, ROOT_NODE_ID);
+        assert!(a11y.node_bounds.is_empty());
+        assert!(a11y.focus_ids.is_empty());
+        assert!(a11y.action_listeners.is_empty());
+    }
+
+    // A frame drawn while accessibility is inactive drops the kept tree, so the
+    // next active frame knows it has nothing to replay.
+    #[test]
+    fn inactive_frame_releases_the_kept_tree() {
+        let mut a11y = new_a11y();
+        assert!(!a11y.can_reuse_nodes());
+        a11y.end_frame(Default::default());
+        assert!(a11y.can_reuse_nodes());
+        a11y.release_finished_frame();
+        assert!(!a11y.can_reuse_nodes());
+    }
+    // End to end through `Window::draw`: a cached view that is reused keeps its
+    // nodes in the tree sent to the platform.
+    #[gpui::test]
+    fn reused_cached_view_keeps_its_nodes(cx: &mut crate::TestAppContext) {
+        use crate::{
+            AppContext as _, Context, Entity, InteractiveElement as _, IntoElement,
+            ParentElement as _, Render, StatefulInteractiveElement as _, StyleRefinement,
+            Styled as _, Window, div,
+        };
+        use std::sync::atomic::Ordering;
+
+        struct List;
+        impl Render for List {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div()
+                    .id("list")
+                    .role(Role::List)
+                    .size_full()
+                    .child(div().id("item").role(Role::ListItem).size_full())
+            }
+        }
+
+        struct Root {
+            list: Entity<List>,
+        }
+        impl Render for Root {
+            fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+                div().size_full().child(
+                    self.list
+                        .clone()
+                        .cached(StyleRefinement::default().size_full()),
+                )
+            }
+        }
+
+        let window = cx.add_window(|_, cx| Root {
+            list: cx.new(|_| List),
+        });
+        let draw = |cx: &mut crate::TestAppContext| {
+            cx.update_window(window.into(), |_, window, cx| {
+                window.draw(cx).clear(cx);
+                // The tree sent to the platform, as the debug dump shows it.
+                let tree = window.debug_a11y_tree_json().unwrap();
+                let roles = tree.matches(r#""role": "List""#).count()
+                    + tree.matches(r#""role": "ListItem""#).count();
+                (roles, window.frame_stage_statistics.views_reused)
+            })
+            .unwrap()
+        };
+
+        window
+            .update(cx, |_, window, _| {
+                window.a11y.active_flag.store(true, Ordering::SeqCst)
+            })
+            .unwrap();
+        // The first accessible frame has no tree to replay from, so it renders
+        // the cached view.
+        let (nodes, mut reused_so_far) = draw(cx);
+        assert_eq!(nodes, 2);
+
+        // Re-render the root only: the list is reused, twice in a row, the
+        // second time from nodes that were themselves replayed.
+        for _ in 0..2 {
+            window.update(cx, |_, _, cx| cx.notify()).unwrap();
+            let (nodes, reused) = draw(cx);
+            assert!(reused > reused_so_far, "the cached list view was reused");
+            assert_eq!(nodes, 2, "the reused view's nodes are still in the tree");
+            reused_so_far = reused;
+        }
+    }
 }
