+    // A cached view's subtree is replayed from the previous frame under the
+    // parent that is current when the view is reused, at whatever depth that
+    // parent now sits, and the replayed range can be replayed again.
+    #[test]
+    fn reused_subtree_replays_under_the_current_parent() {
+        let view = NodeId(2);
+        let leaf = NodeId(3);
+        let sibling = NodeId(4);
+        let build_view = |builder: &mut A11yNodeBuilder| {
+            assert!(builder.push(view, test_node()));
+            assert!(builder.push_leaf(leaf, test_node()));
+            builder.pop(); // view
+            assert!(builder.push(sibling, test_node()));
+            builder.pop(); // sibling
+        };
+
+        // Frame 1: the view's nodes are children of the root.
+        let mut builder = new_builder();
+        let start = builder.index();
+        build_view(&mut builder);
+        let range = start..builder.index();
+        builder.finalize();
+
+        // Frame 2: the view is reused inside a new container.
+        let container = NodeId(10);
+        builder.begin_frame(None);
+        assert!(builder.push(container, test_node()));
+        let start = builder.index();
+        assert_eq!(builder.replay(range).len(), 3);
+        let range = start..builder.index();
+        builder.pop(); // container
+        let update = builder.finalize();
+        assert_eq!(node_children(&update, ROOT_NODE_ID), Some(vec![container]));
+        assert_eq!(node_children(&update, container), Some(vec![view, sibling]));
+        assert_eq!(node_children(&update, view), Some(vec![leaf]));
+        assert_eq!(update.nodes.len(), 5);
+
+        // Frame 3: reused again, back at the root, from frame 2's range.
+        builder.begin_frame(None);
+        builder.replay(range);
+        let update = builder.finalize();
+        assert_eq!(
+            node_children(&update, ROOT_NODE_ID),
+            Some(vec![view, sibling])
+        );
+        assert_eq!(node_children(&update, view), Some(vec![leaf]));
+        assert_eq!(update.nodes.len(), 4);
+    }
