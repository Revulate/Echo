+/// GPU execution time for the most recently completed window frame.
+///
+/// This is a local Echo extension (branch `echo-paint-fork`). The Windows
+/// Direct3D 11 backend measures the submitted render pass with timestamp and
+/// timestamp-disjoint queries. Results are read back on later frames without
+/// flushing or blocking the GPU; other platforms return `None`.
+#[derive(Debug, Clone, Copy)]
+pub struct GpuFrameStatistics {
+    /// GPU time between the frame's start and end timestamp, in milliseconds.
+    pub gpu_frame_time_ms: f64,
+    /// Running count of successfully resolved, non-disjoint timestamp samples.
+    pub sample_count: u64,
+}
