+    /// Enable the bounded, asynchronous Direct3D timestamp-query ring used by Echo's
+    /// diagnostics. Query objects are allocated lazily and released when disabled.
+    pub(crate) fn set_gpu_timing_enabled(&mut self, enabled: bool) -> Result<()> {
+        if !enabled {
+            self.gpu_timing_enabled = false;
+            self.gpu_timing_unavailable = false;
+            self.gpu_frame_timer = None;
+            return Ok(());
+        }
+        self.gpu_timing_enabled = true;
+        if self.gpu_frame_timer.is_some() || self.gpu_timing_unavailable {
+            return Ok(());
+        }
+
+        let device = &self.devices.as_ref().context("devices missing")?.device;
+        match GpuFrameTimer::new(device) {
+            Ok(timer) => {
+                self.gpu_frame_timer = Some(timer);
+                Ok(())
+            }
+            Err(error) => {
+                self.gpu_timing_unavailable = true;
+                Err(error).context("Creating Direct3D GPU timestamp query ring")
+            }
+        }
+    }
+
+    /// Latest non-disjoint GPU timestamp result. Never waits for an in-flight query.
+    pub(crate) fn gpu_frame_statistics(&self) -> Option<GpuFrameStatistics> {
+        self.gpu_frame_timer.as_ref()?.statistics()
+    }
