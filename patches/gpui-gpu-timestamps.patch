+const GPU_TIMESTAMP_QUERY_SLOTS: usize = 4;
+
+struct GpuFrameTimer {
+    slots: Vec<GpuTimestampSlot>,
+    active_slot: Option<usize>,
+    next_slot: usize,
+    sample_count: u64,
+    latest_gpu_frame_time_ms: Option<f64>,
+}
+
+struct GpuTimestampSlot {
+    disjoint: ID3D11Query,
+    start: ID3D11Query,
+    end: ID3D11Query,
+    pending: bool,
+}
+
+enum GpuTimestampPoll {
+    Pending,
+    Complete(Option<f64>),
+}
+
+impl GpuFrameTimer {
+    fn new(device: &ID3D11Device) -> Result<Self> {
+        let mut slots = Vec::with_capacity(GPU_TIMESTAMP_QUERY_SLOTS);
+        for _ in 0..GPU_TIMESTAMP_QUERY_SLOTS {
+            slots.push(GpuTimestampSlot {
+                disjoint: Self::create_query(device, D3D11_QUERY_TIMESTAMP_DISJOINT)?,
+                start: Self::create_query(device, D3D11_QUERY_TIMESTAMP)?,
+                end: Self::create_query(device, D3D11_QUERY_TIMESTAMP)?,
+                pending: false,
+            });
+        }
+        Ok(Self {
+            slots,
+            active_slot: None,
+            next_slot: 0,
+            sample_count: 0,
+            latest_gpu_frame_time_ms: None,
+        })
+    }
+
+    fn create_query(device: &ID3D11Device, query: D3D11_QUERY) -> Result<ID3D11Query> {
+        let descriptor = D3D11_QUERY_DESC {
+            Query: query,
+            MiscFlags: 0,
+        };
+        let mut result = None;
+        unsafe { device.CreateQuery(&descriptor, Some(&mut result))? };
+        result.context("Direct3D 11 CreateQuery returned no query object")
+    }
+
+    fn begin_frame(&mut self, context: &ID3D11DeviceContext) {
+        self.collect_available(context);
+        if self.active_slot.is_some() || self.slots.is_empty() {
+            return;
+        }
+
+        let Some(index) = (0..self.slots.len())
+            .map(|offset| (self.next_slot + offset) % self.slots.len())
+            .find(|index| !self.slots[*index].pending)
+        else {
+            // The GPU is more than the bounded query ring behind. Skip this frame
+            // instead of flushing or waiting on the render thread.
+            return;
+        };
+
+        let slot = &self.slots[index];
+        unsafe {
+            context.Begin(&slot.disjoint);
+            context.End(&slot.start);
+        }
+        self.active_slot = Some(index);
+    }
+
+    fn end_frame(&mut self, context: &ID3D11DeviceContext) {
+        let Some(index) = self.active_slot.take() else {
+            return;
+        };
+        let slot = &mut self.slots[index];
+        unsafe {
+            context.End(&slot.end);
+            context.End(&slot.disjoint);
+        }
+        slot.pending = true;
+        self.next_slot = (index + 1) % self.slots.len();
+    }
+
+    fn collect_available(&mut self, context: &ID3D11DeviceContext) {
+        let mut completed_count = 0u64;
+        let mut newest_ms = None;
+        for slot in &mut self.slots {
+            if !slot.pending {
+                continue;
+            }
+            match Self::poll_slot(context, slot) {
+                Ok(GpuTimestampPoll::Pending) => {}
+                Ok(GpuTimestampPoll::Complete(duration_ms)) => {
+                    slot.pending = false;
+                    completed_count += u64::from(duration_ms.is_some());
+                    if duration_ms.is_some() {
+                        newest_ms = duration_ms;
+                    }
+                }
+                Err(error) => {
+                    slot.pending = false;
+                    log::warn!("Failed to resolve Direct3D GPU timestamp query: {error:#}");
+                }
+            }
+        }
+        self.sample_count = self.sample_count.saturating_add(completed_count);
+        if newest_ms.is_some() {
+            self.latest_gpu_frame_time_ms = newest_ms;
+        }
+    }
+
+    fn poll_slot(
+        context: &ID3D11DeviceContext,
+        slot: &GpuTimestampSlot,
+    ) -> Result<GpuTimestampPoll> {
+        let Some(disjoint) =
+            Self::try_get_data::<D3D11_QUERY_DATA_TIMESTAMP_DISJOINT>(context, &slot.disjoint)?
+        else {
+            return Ok(GpuTimestampPoll::Pending);
+        };
+        let Some(start) = Self::try_get_data::<u64>(context, &slot.start)? else {
+            return Ok(GpuTimestampPoll::Pending);
+        };
+        let Some(end) = Self::try_get_data::<u64>(context, &slot.end)? else {
+            return Ok(GpuTimestampPoll::Pending);
+        };
+
+        if disjoint.Disjoint.as_bool() || disjoint.Frequency == 0 || end < start {
+            return Ok(GpuTimestampPoll::Complete(None));
+        }
+        let duration_ms = (end - start) as f64 * 1000.0 / disjoint.Frequency as f64;
+        Ok(GpuTimestampPoll::Complete(
+            duration_ms.is_finite().then_some(duration_ms),
+        ))
+    }
+
+    fn try_get_data<T: Default>(
+        context: &ID3D11DeviceContext,
+        query: &ID3D11Query,
+    ) -> Result<Option<T>> {
+        let mut value = T::default();
+        let hr = unsafe {
+            (Interface::vtable(context).GetData)(
+                Interface::as_raw(context),
+                Interface::as_raw(query),
+                (&mut value as *mut T).cast(),
+                std::mem::size_of::<T>() as u32,
+                D3D11_ASYNC_GETDATA_DONOTFLUSH.0 as u32,
+            )
+        };
+        match hr.0 {
+            0 => Ok(Some(value)), // S_OK: result is ready.
+            1 => Ok(None),        // S_FALSE: do not wait or flush.
+            _ => {
+                hr.ok().context("Direct3D 11 GetData failed")?;
+                Ok(None)
+            }
+        }
+    }
+
+    fn statistics(&self) -> Option<GpuFrameStatistics> {
+        Some(GpuFrameStatistics {
+            gpu_frame_time_ms: self.latest_gpu_frame_time_ms?,
+            sample_count: self.sample_count,
+        })
+    }
+}
