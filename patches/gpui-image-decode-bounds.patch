+                            .into_decoder()
+                            .map_err(|error| anyhow!(error).context("creating image decoder"))?;
+                        IMAGE_URI_DECODE_LIMITS.frame_rgba_bytes(decoder.dimensions())?;
+                        decode_static_image_from_decoder(decoder)?
+                    }
                     _ => decode_static_image(&bytes, format)?,
                 };
 
