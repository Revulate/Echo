+                    enforce_uri_decode_bounds.then_some(&IMAGE_URI_DECODE_LIMITS);
                 let data = match format {
-                    ImageFormat::Gif => decode_gif_image(&bytes)?,
-                    ImageFormat::WebP => decode_webp_image(&bytes)?,
