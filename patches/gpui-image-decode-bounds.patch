+/// Decoded-size limits for untrusted image bytes (local Echo extension,
+/// branch `echo-paint-fork`).
+///
+/// The URI image loader passes these so a remote image cannot make GPUI
+/// allocate an unbounded raster. Files and the clipboard decode without limits.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ImageDecodeLimits {
+    /// Largest accepted width or height, in pixels.
+    pub max_dimension: u32,
+    /// Largest accepted RGBA size of one frame, in bytes.
+    pub max_frame_rgba_bytes: u64,
+    /// Largest accepted RGBA size of all frames together, in bytes.
+    pub max_decoded_bytes: u64,
+    /// Largest accepted number of frames.
+    pub max_frames: usize,
+}
+
+impl ImageDecodeLimits {
+    /// Returns the RGBA size of one frame with these dimensions, or an error
+    /// when the dimensions are empty or exceed the limits.
+    pub(crate) fn frame_rgba_bytes(&self, dimensions: (u32, u32)) -> Result<u64> {
+        let (width, height) = dimensions;
+        let rgba_bytes = u64::from(width)
+            .checked_mul(u64::from(height))
+            .and_then(|pixels| pixels.checked_mul(4))
+            .with_context(|| format!("image dimensions {width}x{height} overflow"))?;
+        if width == 0
+            || height == 0
+            || width > self.max_dimension
+            || height > self.max_dimension
+            || rgba_bytes > self.max_frame_rgba_bytes
+        {
+            anyhow::bail!(
+                "image has unsupported decoded dimensions {width}x{height} \
+                 ({rgba_bytes} RGBA bytes); limits are {}px per axis and {} bytes per frame",
+                self.max_dimension,
+                self.max_frame_rgba_bytes
+            );
+        }
+        Ok(rgba_bytes)
+    }
+}
+
 fn decode_animated_frames<'a>(
     decoder: impl image::AnimationDecoder<'a>,
     format_name: &str,
+    limits: Option<&ImageDecodeLimits>,
 ) -> Result<SmallVec<[Frame; 1]>> {
     let mut frames = SmallVec::new();
+    let mut decoded_bytes = 0u64;
 
     for frame in decoder.into_frames() {
         match frame {
             Ok(mut frame) => {
+                if let Some(limits) = limits {
+                    if frames.len() >= limits.max_frames {
+                        anyhow::bail!(
+                            "{format_name} exceeds the {}-frame decode limit",
+                            limits.max_frames
+                        );
+                    }
+                    let frame_bytes = limits.frame_rgba_bytes(frame.buffer().dimensions())?;
+                    decoded_bytes = decoded_bytes.saturating_add(frame_bytes);
+                    if decoded_bytes > limits.max_decoded_bytes {
+                        anyhow::bail!(
+                            "{format_name} exceeds the {}-byte cumulative decode limit",
+                            limits.max_decoded_bytes
+                        );
+                    }
+                }
                 // Convert from RGBA to BGRA.
                 for pixel in frame.buffer_mut().chunks_exact_mut(4) {
                     pixel.swap(0, 2);
@@ -3438,17 +3499,34 @@ fn decode_animated_frames<'a>(
     Ok(frames)
 }
 
-pub(crate) fn decode_gif_image(bytes: &[u8]) -> Result<SmallVec<[Frame; 1]>> {
+/// Decodes every frame of a GIF. With `limits`, the canvas size is checked
+/// before any frame is decoded and each decoded frame is checked as well.
+pub(crate) fn decode_gif_image(
+    bytes: &[u8],
+    limits: Option<&ImageDecodeLimits>,
+) -> Result<SmallVec<[Frame; 1]>> {
     let decoder = GifDecoder::new(Cursor::new(bytes))?;
-    decode_animated_frames(decoder, "GIF")
+    if let Some(limits) = limits {
+        limits.frame_rgba_bytes(decoder.dimensions())?;
+    }
+    decode_animated_frames(decoder, "GIF", limits)
 }
 
-pub(crate) fn decode_webp_image(bytes: &[u8]) -> Result<SmallVec<[Frame; 1]>> {
+/// Decodes a static or animated WebP. With `limits`, the canvas size is
+/// checked before any frame is decoded and each decoded frame is checked as
+/// well.
+pub(crate) fn decode_webp_image(
+    bytes: &[u8],
+    limits: Option<&ImageDecodeLimits>,
+) -> Result<SmallVec<[Frame; 1]>> {
     let mut decoder = WebPDecoder::new(Cursor::new(bytes))?;
+    if let Some(limits) = limits {
+        limits.frame_rgba_bytes(decoder.dimensions())?;
+    }
 
     if decoder.has_animation() {
         let _ = decoder.set_background_color(Rgba([0, 0, 0, 0]));
-        decode_animated_frames(decoder, "WebP")
+        decode_animated_frames(decoder, "WebP", limits)
     } else {
         decode_static_image_from_decoder(decoder)
     }
@@ -3517,10 +3595,10 @@ impl Image {
     /// Convert the clipboard image to an `ImageData` object.
     pub fn to_image_data(&self, svg_renderer: SvgRenderer) -> Result<Arc<RenderImage>> {
         let frames = match self.format {
-            ImageFormat::Gif => decode_gif_image(&self.bytes)?,
+            ImageFormat::Gif => decode_gif_image(&self.bytes, None)?,
             ImageFormat::Png => decode_static_image(&self.bytes, image::ImageFormat::Png)?,
             ImageFormat::Jpeg => decode_static_image(&self.bytes, image::ImageFormat::Jpeg)?,
-            ImageFormat::Webp => decode_webp_image(&self.bytes)?,
+            ImageFormat::Webp => decode_webp_image(&self.bytes, None)?,
             ImageFormat::Bmp => decode_static_image(&self.bytes, image::ImageFormat::Bmp)?,
             ImageFormat::Tiff => decode_static_image(&self.bytes, image::ImageFormat::Tiff)?,
             ImageFormat::Ico => decode_static_image(&self.bytes, image::ImageFormat::Ico)?,
