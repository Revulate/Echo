             let bytes = match source.clone() {
                 Resource::Path(uri) => fs::read(uri.as_ref())?,
                 Resource::Uri(uri) => {
@@ -779,9 +794,18 @@ impl Asset for ImageAssetLoader {
             };
 
             if let Ok(format) = image::guess_format(&bytes) {
