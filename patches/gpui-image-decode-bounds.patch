+// A generic URI image may bypass Echo's stricter media decoder, so keep the
+// framework's decoded raster allocation bounded as well as its transport body.
+const IMAGE_URI_MAX_DIMENSION: u32 = 8192;
+const IMAGE_URI_MAX_FRAME_RGBA_BYTES: u64 = 64 * 1024 * 1024;
+const IMAGE_URI_MAX_DECODED_BYTES: u64 = 256 * 1024 * 1024;
+const IMAGE_URI_MAX_DECODED_FRAMES: usize = 1024;
+
+const IMAGE_URI_DECODE_LIMITS: ImageDecodeLimits = ImageDecodeLimits {
+    max_dimension: IMAGE_URI_MAX_DIMENSION,
+    max_frame_rgba_bytes: IMAGE_URI_MAX_FRAME_RGBA_BYTES,
+    max_decoded_bytes: IMAGE_URI_MAX_DECODED_BYTES,
+    max_frames: IMAGE_URI_MAX_DECODED_FRAMES,
+};
+
 fn image_uri_retry_delay(uri: &SharedUri, failed_attempt: u8) -> Duration {
     let exponential_ms = 100u64.saturating_mul(1u64 << failed_attempt.saturating_sub(1));
     let jitter_ms = crate::hash(uri) % 100;
@@ -651,6 +665,7 @@ impl Asset for ImageAssetLoader {
         let svg_renderer = cx.svg_renderer();
         let asset_source = cx.asset_source().clone();
