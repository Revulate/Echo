     }
 }
 
+const HARDWARE_ADAPTER_PROBE_INTERVAL: Duration = Duration::from_secs(1);
+const HARDWARE_ADAPTER_RETRY_MAX_INTERVAL: Duration = Duration::from_secs(60);
+
+/// Watches for a hardware adapter to become available while rendering runs on
+/// a software adapter, so device recovery can move back to the GPU.
+pub(crate) struct HardwareAdapterProbe {
+    factory: Option<IDXGIFactory6>,
+    next_check: Instant,
+    retry_interval: Duration,
+}
+
+impl HardwareAdapterProbe {
+    pub(crate) fn new() -> Self {
+        Self {
+            factory: None,
+            next_check: Instant::now() + HARDWARE_ADAPTER_PROBE_INTERVAL,
+            retry_interval: HARDWARE_ADAPTER_PROBE_INTERVAL,
+        }
+    }
+
+    /// Returns true when a hardware adapter is enumerable and recovery should
+    /// be attempted. Checks at most once per second; when a return attempt
+    /// still lands on a software adapter, retries back off up to a minute
+    /// unless the adapter enumeration changes.
+    pub(crate) fn hardware_adapter_available(&mut self, devices: &DirectXDevices) -> bool {
+        let now = Instant::now();
+        if now < self.next_check {
+            return false;
+        }
+        let factory = self
+            .factory
+            .get_or_insert_with(|| devices.dxgi_factory.clone());
+        if !unsafe { factory.IsCurrent() }.as_bool() {
+            let Some(fresh) = unsafe {
+                CreateDXGIFactory2::<IDXGIFactory6>(DXGI_CREATE_FACTORY_FLAGS::default())
+            }
+            .log_err() else {
+                self.next_check = now + HARDWARE_ADAPTER_PROBE_INTERVAL;
+                return false;
+            };
+            *factory = fresh;
+            self.retry_interval = HARDWARE_ADAPTER_PROBE_INTERVAL;
+        }
+        if has_hardware_adapter(factory) {
+            self.next_check = now + self.retry_interval;
+            self.retry_interval =
+                (self.retry_interval * 2).min(HARDWARE_ADAPTER_RETRY_MAX_INTERVAL);
+            true
+        } else {
+            self.next_check = now + HARDWARE_ADAPTER_PROBE_INTERVAL;
+            false
+        }
+    }
+}
+
+fn is_software_adapter(adapter: &IDXGIAdapter1) -> bool {
+    unsafe { adapter.GetDesc1() }
+        .map(|desc| desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32 != 0)
+        .unwrap_or(false)
+}
+
+fn has_hardware_adapter(dxgi_factory: &IDXGIFactory6) -> bool {
+    (0..)
+        .map_while(|adapter_index| unsafe { dxgi_factory.EnumAdapters(adapter_index) }.ok())
+        .filter_map(|adapter| adapter.cast::<IDXGIAdapter1>().ok())
+        .any(|adapter| !is_software_adapter(&adapter))
+}
+
 #[inline]
 fn check_debug_layer_available() -> bool {
     #[cfg(debug_assertions)]
@@ -111,32 +184,67 @@ fn get_adapter(
     ID3D11Device,
     ID3D11DeviceContext,
     D3D_FEATURE_LEVEL,
+    bool,
 )> {
+    let mut adapters = Vec::new();
     for adapter_index in 0.. {
-        let adapter: IDXGIAdapter1 = unsafe { dxgi_factory.EnumAdapters(adapter_index)?.cast()? };
-        if let Ok(desc) = unsafe { adapter.GetDesc1() } {
-            let gpu_name = String::from_utf16_lossy(&desc.Description)
-                .trim_matches(char::from(0))
-                .to_string();
-            log::info!("Using GPU: {}", gpu_name);
+        let Ok(adapter) = (unsafe { dxgi_factory.EnumAdapters(adapter_index) }) else {
+            break;
+        };
+        if let Some(adapter) = adapter.cast::<IDXGIAdapter1>().log_err() {
+            adapters.push(adapter);
         }
-        // Check to see whether the adapter supports Direct3D 11 and create
-        // the device if it does.
-        let mut context: Option<ID3D11DeviceContext> = None;
-        let mut feature_level = D3D_FEATURE_LEVEL::default();
-        if let Some(device) = get_device(
-            &adapter,
-            Some(&mut context),
-            Some(&mut feature_level),
-            debug_layer_available,
-        )
-        .log_err()
+    }
+
+    // Hardware adapters first; a software adapter (WARP) is only a fallback.
+    for software in [false, true] {
+        for adapter in adapters
+            .iter()
+            .filter(|adapter| is_software_adapter(adapter) == software)
         {
-            return Ok((adapter, device, context.unwrap(), feature_level));
+            // Check to see whether the adapter supports Direct3D 11 and create
+            // the device if it does.
+            let mut context: Option<ID3D11DeviceContext> = None;
+            let mut feature_level = D3D_FEATURE_LEVEL::default();
+            let Some(device) = get_device(
+                adapter,
+                Some(&mut context),
+                Some(&mut feature_level),
+                debug_layer_available,
+            )
+            .log_err() else {
+                continue;
+            };
+            log_chosen_adapter(adapter, software);
+            return Ok((
+                adapter.clone(),
+                device,
+                context.unwrap(),
+                feature_level,
+                software,
+            ));
         }
     }
 
-    unreachable!()
+    anyhow::bail!("No DXGI adapter could create a Direct3D 11 device")
+}
+
+fn log_chosen_adapter(adapter: &IDXGIAdapter1, software: bool) {
+    if let Ok(desc) = unsafe { adapter.GetDesc1() } {
+        let gpu_name = String::from_utf16_lossy(&desc.Description)
+            .trim_matches(char::from(0))
+            .to_string();
+        log::info!(
+            "Using GPU: {gpu_name} (vendor {:#06x}, device {:#06x}, software: {software})",
+            desc.VendorId,
+            desc.DeviceId,
+        );
+    }
+    if software {
+        log::warn!(
+            "No hardware GPU adapter could create a Direct3D 11 device; rendering is software-emulated"
+        );
+    }
 }
 
