 use windows::core::Interface;
 
+use std::time::{Duration, Instant};
+
 pub(crate) fn try_to_recover_from_device_lost<T>(mut f: impl FnMut() -> Result<T>) -> Result<T> {
     (0..5)
         .map(|i| {
@@ -41,6 +43,8 @@ pub(crate) struct DirectXDevices {
     pub(crate) dxgi_factory: IDXGIFactory6,
     pub(crate) device: ID3D11Device,
     pub(crate) device_context: ID3D11DeviceContext,
+    /// Whether the device runs on a software adapter (WARP).
+    pub(crate) software: bool,
 }
 
 impl DirectXDevices {
@@ -48,7 +52,7 @@ impl DirectXDevices {
         let debug_layer_available = check_debug_layer_available();
         let dxgi_factory =
             get_dxgi_factory(debug_layer_available).context("Creating DXGI factory")?;
-        let (adapter, device, device_context, feature_level) =
+        let (adapter, device, device_context, feature_level, software) =
             get_adapter(&dxgi_factory, debug_layer_available).context("Getting DXGI adapter")?;
         match feature_level {
             D3D_FEATURE_LEVEL_11_1 => {
@@ -68,10 +72,79 @@ impl DirectXDevices {
