+    /// Inserts `sprite` as an animated image slot (local Echo extension).
+    /// Returns whether it was kept, rather than clipped away.
+    ///
+    /// The slot's index is stored in the sprite's `pad`, which renderers ignore,
+    /// so [`Self::finish`] can find the sprite after sorting and
+    /// [`Self::replay`] can carry the slot into the next scene.
+    pub(crate) fn insert_animated_image(
+        &mut self,
+        mut sprite: PolychromeSprite,
+        mut slot: AnimatedImageSlot,
+    ) -> bool {
+        sprite.pad = animated_image_slot_id(self.animated_image_slots.len());
+        slot.op_index = self.paint_operations.len();
