+
+/// An animated image sprite that [`Window::patch_animated_image`] can retarget
+/// to another frame without redrawing the window.
+#[derive(Clone, Copy)]
+struct AnimatedImageSlot {
+    key: u64,
+    /// Index of the sprite's operation in the scene's paint operations.
+    op_index: usize,
+    visible_bounds: Bounds<Pixels>,
+    image_bounds: Bounds<Pixels>,
