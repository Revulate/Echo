+/// An image painted with `Window::paint_animated_image`, which
+/// `Window::patch_animated_image` can show another frame of without redrawing
+/// the window. Local Echo extension (`echo-paint-fork`).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct AnimatedImageSlot {
+    pub(crate) key: u64,
+    /// Index of the slot's primitive in the scene's paint operations, which
+    /// cached views replay.
+    pub(crate) op_index: usize,
+    pub(crate) visible_bounds: Bounds<Pixels>,
+    pub(crate) image_bounds: Bounds<Pixels>,
+    /// Index of the slot's primitive in the sorted primitive array, once
+    /// [`Scene::finish`] has run.
+    pub(crate) primitive_index: Option<usize>,
+}
+
+impl AnimatedImageSlot {
+    pub(crate) fn new(
+        key: u64,
+        visible_bounds: Bounds<Pixels>,
+        image_bounds: Bounds<Pixels>,
+    ) -> Self {
+        Self {
+            key,
+            op_index: 0,
+            visible_bounds,
+            image_bounds,
+            primitive_index: None,
+        }
+    }
+}
+
+/// The value stored in a primitive's slot field for slot `index`; 0 means no
+/// slot, so primitives built with a zeroed `pad` have none.
+fn animated_image_slot_id(index: usize) -> u32 {
+    u32::try_from(index + 1).unwrap_or(0)
+}
