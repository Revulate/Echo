+
+#[derive(Clone, Copy)]
+enum AnimatedImageSlotResolution {
+    Resolved(ResolvedAnimatedImageSlot),
+    /// The key was painted more than once, so no single sprite can be patched.
+    Ambiguous,
+    /// The sprite could not be found in the sorted scene.
+    Unresolved,
+}
+
+#[derive(Clone, Copy)]
+struct ResolvedAnimatedImageSlot {
+    slot: AnimatedImageSlot,
+    /// Index of the sprite in the sorted `Scene::polychrome_sprites`.
+    sprite_index: usize,
+}
