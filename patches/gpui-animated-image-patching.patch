+
+/// Cumulative CPU time a window has spent in each stage of its frame pipeline.
+///
+/// This is a local Echo extension (branch `echo-paint-fork`). Every field only
+/// grows for the lifetime of the window, so a consumer diffs two snapshots taken
+/// at different times to get per-interval costs. Timing costs a handful of
+/// monotonic clock reads per frame and never changes pacing.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct FrameStageStatistics {
+    /// Number of completed `Window::draw` calls.
+    pub frames_drawn: u64,
+    /// Number of frames handed to the platform renderer.
+    pub frames_presented: u64,
+    /// Total time inside `Window::draw`.
+    pub draw_nanos: u64,
+    /// Time spent laying out, prepainting and painting the element trees.
+    pub layout_paint_nanos: u64,
+    /// Part of `layout_paint_nanos` spent rendering views and requesting layout.
+    pub request_layout_nanos: u64,
+    /// Part of `layout_paint_nanos` spent computing layout and prepainting.
+    pub prepaint_nanos: u64,
+    /// Part of `layout_paint_nanos` spent painting.
+    pub paint_nanos: u64,
+    /// Views whose `render` ran.
+    pub views_rendered: u64,
+    /// Cached views replayed from the previous frame.
+    pub views_reused: u64,
+    /// Time spent ordering the finished scene's primitives.
+    pub scene_finish_nanos: u64,
+    /// Time inside the platform renderer for a frame: buffer upload, command
+    /// encoding and the swap-chain present call.
+    pub present_nanos: u64,
+    /// Primitives in finished scenes.
+    pub primitives: u64,
+    /// Primitives copied from the previous frame by cached views.
+    pub replayed_primitives: u64,
+    /// Presents that sent only damaged regions to the platform.
+    pub partial_presents: u64,
+    /// Animated image sprites retargeted by `Window::patch_animated_image`.
+    pub animated_image_patches: u64,
+    /// `Window::patch_animated_image` calls refused, by reason: key not painted
+    /// in the presented frame, key painted more than once, sprite not found
+    /// after sorting, atlas or frame data unavailable, draw in progress.
+    pub animated_image_patch_rejections: [u64; 5],
+    /// Renderer-side split of `present_nanos`, when the backend reports one.
+    pub renderer: Option<RendererCpuStatistics>,
+}
+
+/// Cumulative CPU time a window's platform renderer spent per frame stage.
+///
+/// This is a local Echo extension (branch `echo-paint-fork`). Values only grow.
+/// The Windows Direct3D 11 renderer reports these; other backends return `None`.
+#[derive(Debug, Clone, Copy, Default)]
+pub struct RendererCpuStatistics {
+    /// Frames the renderer drew.
+    pub frames: u64,
+    /// Time copying primitive instance data into GPU buffers.
+    pub upload_nanos: u64,
+    /// Time clearing the target and encoding draw calls.
+    pub encode_nanos: u64,
+    /// Time inside the swap-chain present call.
+    pub present_call_nanos: u64,
+    /// Bytes of instance data copied into GPU buffers.
+    pub upload_bytes: u64,
+}
