+#[cfg(test)]
+mod animated_image_patch_tests {
+    use std::{sync::Arc, time::Duration};
+
+    use image::{Frame, Rgba, RgbaImage};
+    use smallvec::SmallVec;
+
+    use super::{AnimatedImageSlotResolution, PresentDamage};
+    use crate::{
+        AnyView, AppContext as _, AtlasTile, Bounds, Context, Corners, Entity, IntoElement,
+        ParentElement as _, Pixels, Render, RenderImage, RenderImageParams, StyleRefinement,
+        Styled as _, TestAppContext, TimedTransformation, Transformation, Window, WindowHandle,
+        canvas, div, fill, point, prelude::FluentBuilder as _, px, red, size, svg,
+    };
+
+    const SQUARE_SVG: &[u8] = br#"<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect width="8" height="16"/></svg>"#;
+
+    fn two_frame_image() -> Arc<RenderImage> {
+        let frames: SmallVec<[Frame; 1]> = (0..2u8)
+            .map(|shade| Frame::new(RgbaImage::from_pixel(4, 4, Rgba([shade, 0, 0, 255]))))
+            .collect();
+        Arc::new(RenderImage::new(frames))
+    }
+
+    fn square(x: f32) -> Bounds<Pixels> {
+        Bounds::new(point(px(x), px(0.)), size(px(10.), px(10.)))
+    }
+
+    /// Paints key 1 inside nested layers, key 2 in the outer layer and key 3
+    /// outside them, between ordinary images and quads, so that layers assign
+    /// the draw orders late and sorting moves the sprites.
+    struct Animated {
+        image: Arc<RenderImage>,
+        other: Arc<RenderImage>,
+        paint_key_twice: bool,
+        renders: usize,
+    }
+
+    impl Render for Animated {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            self.renders += 1;
+            let image = self.image.clone();
+            let other = self.other.clone();
+            let paint_key_twice = self.paint_key_twice;
+            canvas(
+                |_, _, _| {},
+                move |_, _, window, _| {
+                    let animated = |window: &mut Window, key: u64, x: f32| {
+                        let bounds = square(x);
+                        window
+                            .paint_animated_image(
+                                key,
+                                bounds,
+                                bounds,
+                                Corners::default(),
+                                image.clone(),
+                                0,
+                                false,
+                            )
+                            .expect("paint animated image")
+                    };
+                    let still = |window: &mut Window, x: f32, frame_index: usize| {
+                        let bounds = square(x);
+                        window
+                            .paint_image(
+                                bounds,
+                                bounds,
+                                Corners::default(),
+                                other.clone(),
+                                frame_index,
+                                false,
+                            )
+                            .expect("paint image");
+                    };
+                    still(window, 0., 1);
+                    window.paint_layer(|window| {
+                        window.paint_quad(fill(square(0.), red()));
+                        window.paint_layer(|window| {
+                            assert!(animated(window, 1, 5.));
+                        });
+                        still(window, 40., 0);
+                        assert!(animated(window, 2, 40.));
+                    });
+                    window.paint_quad(fill(square(80.), red()));
+                    assert!(animated(window, 3, 80.));
+                    if paint_key_twice {
+                        assert!(animated(window, 3, 120.));
+                    }
+                },
+            )
+            .size_full()
+        }
+    }
+
+    struct Root {
+        child: AnyView,
+        animated_svg: bool,
+    }
+
+    impl Render for Root {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            div()
+                .size_full()
+                .when(self.animated_svg, |root| {
+                    root.child(
+                        svg()
+                            .data(SQUARE_SVG)
+                            .size(px(16.))
+                            .text_color(red())
+                            .with_timed_transformation(TimedTransformation::rotation(
+                                Duration::from_secs(1),
+                                Transformation::default(),
+                            )),
+                    )
+                })
+                .child(
+                    self.child
+                        .clone()
+                        .cached(StyleRefinement::default().size_full()),
+                )
+        }
+    }
+
+    /// Opens a window that shows `child` as a cached view and draws it.
+    fn open_view(
+        child: AnyView,
+        animated_svg: bool,
+        cx: &mut TestAppContext,
+    ) -> WindowHandle<Root> {
+        let window = cx.add_window(move |_, _| Root {
+            child,
+            animated_svg,
+        });
+        cx.run_until_parked();
+        draw(window, cx);
+        window
+    }
+
+    fn open(
+        animated_svg: bool,
+        paint_key_twice: bool,
+        cx: &mut TestAppContext,
+    ) -> (WindowHandle<Root>, Entity<Animated>, Arc<RenderImage>) {
+        let image = two_frame_image();
+        let child = cx.new(|_| Animated {
+            image: image.clone(),
+            other: two_frame_image(),
+            paint_key_twice,
+            renders: 0,
+        });
+        let window = open_view(child.clone().into(), animated_svg, cx);
+        (window, child, image)
+    }
+
+    /// Re-renders only the root, so the cached child is replayed, and checks
+    /// that it was.
+    fn draw_replaying_child(window: WindowHandle<Root>, cx: &mut TestAppContext) {
+        window
+            .update(cx, |_, _, cx| cx.notify())
+            .expect("notify root");
+        let reused_before = cx
+            .update_window(window.into(), |_, window, _| {
+                window.frame_stage_statistics.views_reused
+            })
+            .unwrap();
+        draw(window, cx);
+        let reused_after = cx
+            .update_window(window.into(), |_, window, _| {
+                window.frame_stage_statistics.views_reused
+            })
+            .unwrap();
+        assert!(reused_after > reused_before, "the child was not replayed");
+    }
+
+    fn draw(window: WindowHandle<Root>, cx: &mut TestAppContext) {
+        cx.update_window(window.into(), |_, window, cx| {
+            window.draw(cx).clear(cx);
+            window.present();
+        })
+        .expect("draw window");
+    }
+
+    fn frame_tile(window: &Window, image: &RenderImage, frame_index: usize) -> AtlasTile {
+        let params = RenderImageParams {
+            image_id: image.id,
+            frame_index,
+        };
+        window
+            .sprite_atlas
+            .get_or_insert_with(params.into(), &mut || Ok(None))
+            .expect("atlas lookup")
+            .expect("frame was uploaded")
+    }
+
+    /// The tile each key's sprite shows in the presented scene.
+    fn slot_tiles(window: &Window, keys: &[u64]) -> Vec<AtlasTile> {
+        keys.iter()
+            .map(|key| {
+                let Some(AnimatedImageSlotResolution::Resolved(slot)) = window
+                    .rendered_frame
+                    .animated_image_sprites
+                    .get(key)
+                    .copied()
+                else {
+                    panic!("key {key} did not resolve");
+                };
+                let index = slot.primitive_index.expect("a resolved slot has a sprite");
+                let sprite = &window.rendered_frame.scene.polychrome_sprites[index];
+                assert_eq!(
+                    sprite.bounds,
+                    slot.visible_bounds.scale(window.scale_factor()),
+                    "key {key} resolved to another sprite"
+                );
+                sprite.tile
+            })
+            .collect()
+    }
+
+    #[crate::test]
+    fn slots_in_nested_layers_and_replayed_views_patch(cx: &mut TestAppContext) {
+        let (window, child, image) = open(false, false, cx);
+        let keys = [1, 2, 3];
+
+        cx.update_window(window.into(), |_, window, _| {
+            let frame0 = frame_tile(window, &image, 0);
+            assert_eq!(slot_tiles(window, &keys), [frame0; 3]);
+            for key in keys {
+                assert!(
+                    window.patch_animated_image(key, &image, 1),
+                    "patch key {key}"
+                );
+            }
+            let frame1 = frame_tile(window, &image, 1);
+            assert_eq!(slot_tiles(window, &keys), [frame1; 3]);
+            assert!(!window.patch_animated_image(4, &image, 1));
+            let statistics = window.frame_stage_statistics;
+            assert_eq!(statistics.animated_image_patches, 3);
+            assert_eq!(statistics.animated_image_patch_rejections, [1, 0, 0, 0, 0]);
+            let PresentDamage::Regions(regions) = &window.present_damage else {
+                panic!("patches after a present damage only their regions");
+            };
+            assert_eq!(regions.len(), 3);
+            window.present();
+            assert_eq!(window.frame_stage_statistics.partial_presents, 1);
+        })
+        .unwrap();
+
+        // Only the root renders. The child is replayed from the patched scene,
+        // and its slots resolve again in the new one.
+        draw_replaying_child(window, cx);
+        assert_eq!(child.read_with(cx, |child, _| child.renders), 1);
+        cx.update_window(window.into(), |_, window, _| {
+            let frame1 = frame_tile(window, &image, 1);
+            assert_eq!(slot_tiles(window, &keys), [frame1; 3]);
+            for key in keys {
+                assert!(
+                    window.patch_animated_image(key, &image, 0),
+                    "patch replayed key {key}"
+                );
+            }
+            let frame0 = frame_tile(window, &image, 0);
+            assert_eq!(slot_tiles(window, &keys), [frame0; 3]);
+        })
+        .unwrap();
+    }
+
+    #[crate::test]
+    fn a_key_painted_twice_is_not_patched(cx: &mut TestAppContext) {
+        let (window, _, image) = open(false, true, cx);
+        cx.update_window(window.into(), |_, window, _| {
+            assert!(window.patch_animated_image(1, &image, 1));
+            assert!(!window.patch_animated_image(3, &image, 1));
+            assert_eq!(
+                window
+                    .frame_stage_statistics
+                    .animated_image_patch_rejections,
+                [0, 1, 0, 0, 0]
+            );
+        })
+        .unwrap();
+    }
+
+    #[crate::test]
+    fn scene_animations_make_patched_presents_full(cx: &mut TestAppContext) {
+        let (window, _, image) = open(true, false, cx);
+        cx.update_window(window.into(), |_, window, _| {
+            assert!(window.scene_animation_interval.get().is_some());
+            assert!(window.patch_animated_image(1, &image, 1));
+            window.present();
+            assert_eq!(window.frame_stage_statistics.partial_presents, 0);
+        })
+        .unwrap();
+    }
