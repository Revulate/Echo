+/// `region` as a back-buffer rectangle, grown to whole pixels and clipped to
+/// the buffer; `None` when nothing of it is inside.
+fn device_rect(region: &Bounds<ScaledPixels>, width: u32, height: u32) -> Option<RECT> {
+    let left = (region.origin.x.0.floor() as i32).max(0);
+    let top = (region.origin.y.0.floor() as i32).max(0);
+    let right = ((region.origin.x.0 + region.size.width.0).ceil() as i32).min(width as i32);
+    let bottom = ((region.origin.y.0 + region.size.height.0).ceil() as i32).min(height as i32);
+    (left < right && top < bottom).then_some(RECT {
+        left,
+        top,
+        right,
+        bottom,
+    })
+}
