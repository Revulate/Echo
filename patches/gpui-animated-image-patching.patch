+
+    /// Find each animated image slot's sprite in the sorted scene.
+    fn resolve_animated_image_slots(&mut self) {
+        let sprites = &self.scene.polychrome_sprites;
+        for slot in &self.animated_image_slots {
+            let Some(PaintOperation::Primitive(Primitive::PolychromeSprite(painted))) =
+                self.scene.paint_operations.get(slot.op_index)
+            else {
+                continue;
+            };
+            let key = (painted.order, painted.tile.tile_id);
+            let start = sprites.partition_point(|sprite| (sprite.order, sprite.tile.tile_id) < key);
+            let sprite_index = sprites[start..]
+                .iter()
+                .take_while(|sprite| (sprite.order, sprite.tile.tile_id) == key)
+                .position(|sprite| sprite.bounds == painted.bounds)
+                .map(|offset| start + offset);
+            let resolution = match sprite_index {
+                Some(sprite_index) => {
+                    AnimatedImageSlotResolution::Resolved(ResolvedAnimatedImageSlot {
+                        slot: *slot,
+                        sprite_index,
+                    })
+                }
+                None => AnimatedImageSlotResolution::Unresolved,
+            };
+            self.animated_image_sprites
+                .entry(slot.key)
+                .and_modify(|existing| *existing = AnimatedImageSlotResolution::Ambiguous)
+                .or_insert(resolution);
+        }
     }
 }
 
