+    /// Map each painted key to its slot. `Scene::finish` has already found
+    /// where each slot's primitive landed after sorting.
+    fn resolve_animated_image_slots(&mut self) {
+        for slot in self.scene.animated_image_slots() {
+            let resolution = match slot.primitive_index {
+                Some(_) => AnimatedImageSlotResolution::Resolved(*slot),
+                None => AnimatedImageSlotResolution::Unresolved,
+            };
+            self.animated_image_sprites
+                .entry(slot.key)
+                .and_modify(|existing| *existing = AnimatedImageSlotResolution::Ambiguous)
+                .or_insert(resolution);
+        }
     }
