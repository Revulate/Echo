+//! Windows non-test diagnostic for platform text geometry.
+//!
+//! Run with `cargo run -p gpui --example platform_text_geometry`. It creates GPUI's normal
+//! platform text system, shapes several DirectWrite-sensitive strings, and exits without opening
+//! an application window. The checks cover UTF-8 source boundaries, bidi platform cells/carets,
+//! logical split/wrap compatibility coordinates, and a mixed-direction range that must occupy
+//! more than one visual span.
+
+#![cfg_attr(not(target_os = "windows"), allow(unused_imports, dead_code))]
+
+#[cfg(target_os = "windows")]
+use unicode_segmentation::UnicodeSegmentation;
+
+#[cfg(not(target_os = "windows"))]
+fn main() {
+    eprintln!("platform_text_geometry is a Windows DirectWrite diagnostic");
+}
+
+#[cfg(target_os = "windows")]
+fn main() {
+    use gpui::{App, TextRun, WindowTextSystem, px};
+    use gpui_platform::application;
+
+    application().run(|cx: &mut App| {
+        let text_system = WindowTextSystem::new(cx.text_system().clone());
+        for text in [
+            "abcdאבגX",
+            "plain LTR",
+            "אבגדה",
+            "office ffi",
+            "a\u{0301}b",
+            "A😀B",
+            // This relies on the normal DirectWrite system fallback configured by the platform
+            // text system; it must still produce source cells/carets even when a fallback face
+            // supplies the emoji glyphs.
+            "👩\u{200d}💻",
+            // DirectWrite draws tabs as zero-glyph runs; each tab must keep its own cell and
+            // caret pair, including inside a bidi line.
+            "a\tb",
+            "a\tאב\tb",
+        ] {
+            let expects_bidi_geometry = text
+                .chars()
+                .any(|character| ('\u{0590}'..='\u{08ff}').contains(&character));
+            let line = text_system.layout_line(
+                text,
+                px(16.),
+                &[TextRun {
+                    len: text.len(),
+                    ..Default::default()
+                }],
+                None,
+            );
+            assert!(
+                line.width.as_f32().is_finite(),
+                "{text:?} has a finite width"
+            );
+            let width_tolerance = px(0.1);
+            assert_eq!(
+                !line.carets.is_empty(),
+                expects_bidi_geometry,
+                "{text:?} only pays DirectWrite per-cluster hit testing for bidi runs"
+            );
+            assert_eq!(
+                !line.visual_cells.is_empty(),
+                expects_bidi_geometry,
+                "{text:?} exposes visual cells exactly when bidi needs platform geometry"
+            );
+            for cell in &line.visual_cells {
+                assert!(text.is_char_boundary(cell.source.start));
+                assert!(text.is_char_boundary(cell.source.end));
+                assert!(cell.source.start < cell.source.end);
+                assert!(cell.visual.start <= cell.visual.end);
+                assert!(cell.visual.start.as_f32().is_finite());
+                assert!(cell.visual.end.as_f32().is_finite());
+                assert!(cell.visual.start >= -width_tolerance);
+                assert!(cell.visual.end <= line.width + width_tolerance);
+                if cell.visual.end > cell.visual.start {
+                    let middle = (cell.visual.start + cell.visual.end) / 2.;
+                    assert_eq!(line.index_for_x(middle), Some(cell.source.start));
+                }
+            }
+            for caret in &line.carets {
+                assert!(text.is_char_boundary(caret.index));
+                assert!(caret.x.as_f32().is_finite());
+                assert!(caret.x >= -width_tolerance);
+                assert!(caret.x <= line.width + width_tolerance);
+                assert_eq!(
+                    line.x_for_index_with_affinity_checked(caret.index, caret.affinity),
+                    Some(caret.x),
+                    "{text:?} retains both logical caret affinities"
+                );
+                let closest = line.closest_index_for_x(caret.x);
+                assert!(
+                    line.carets
+                        .iter()
+                        .any(|candidate| candidate.index == closest && candidate.x == caret.x),
+                    "{text:?} caret point maps to a concrete physical caret"
+                );
+                let reverse = line.caret_for_x(caret.x).unwrap();
+                assert_eq!(
+                    line.x_for_index_with_affinity_checked(reverse.index, reverse.affinity),
+                    Some(caret.x),
+                    "{text:?} x -> Caret(index, affinity) -> x is exact"
+                );
+            }
+            if expects_bidi_geometry {
+                assert_cluster_safe_geometry(text, &line);
+            }
+            for (tab, _) in text.match_indices('\t') {
+                assert!(
+                    line.runs
+                        .iter()
+                        .flat_map(|run| run.glyphs.iter())
+                        .any(|glyph| glyph.index == tab),
+                    "{text:?} keeps an invisible glyph for the tab at {tab}"
+                );
+                let spans = line.visual_spans_for_range(tab..tab + 1);
+                assert!(
+                    spans.len() == 1 && spans[0].end - spans[0].start > px(1.),
+                    "{text:?} tab at {tab} keeps its native advance: {spans:?}"
+                );
+            }
+        }
+
+        // All of these contain a bidi trigger plus a sequence that must be atomic to editing:
+        // combining mark, ZWJ emoji, variation selector, and the common ffi ligature candidate.
+        let complex_bidi = "אב a\u{0301} 👩\u{200d}💻 ✈\u{fe0f} office ffi";
+        let complex_line = text_system.layout_line(
+            complex_bidi,
+            px(16.),
+            &[TextRun {
+                len: complex_bidi.len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        assert!(!complex_line.visual_cells.is_empty() && !complex_line.carets.is_empty());
+        assert_cluster_safe_geometry(complex_bidi, &complex_line);
+
+        let range_failure = layout_line_with_geometry_fault(&text_system, "range", complex_bidi);
+        assert!(
+            !range_failure.visual_cells.is_empty() && !range_failure.carets.is_empty(),
+            "endpoint carets synthesize cluster cells when range hit testing fails"
+        );
+        assert_cluster_safe_geometry(
+            "אב a\u{0301} 👩\u{200d}💻 ✈\u{fe0f} office ffi [range]",
+            &range_failure,
+        );
+
+        let caret_failure = layout_line_with_geometry_fault(&text_system, "caret", complex_bidi);
+        assert!(
+            !caret_failure.visual_cells.is_empty() && !caret_failure.carets.is_empty(),
+            "range cells synthesize both cluster caret sides when caret hit testing fails"
+        );
+        assert_cluster_safe_geometry(
+            "אב a\u{0301} 👩\u{200d}💻 ✈\u{fe0f} office ffi [caret]",
+            &caret_failure,
+        );
+        assert_synthesized_carets_bound_cells(&caret_failure);
+
+        let single_endpoint_failure =
+            layout_line_with_geometry_fault(&text_system, "range-leading-caret", complex_bidi);
+        assert!(
+            single_endpoint_failure.has_bidi_runs
+                && !single_endpoint_failure.bidi_geometry_complete
+                && single_endpoint_failure.visual_cells.is_empty()
+                && single_endpoint_failure.carets.is_empty(),
+            "range failure plus only one endpoint must not fabricate zero-width selection or an opposite caret"
+        );
+        assert_eq!(single_endpoint_failure.index_for_x(px(1.)), None);
+        assert!(single_endpoint_failure.caret_for_x(px(1.)).is_none());
+        assert!(
+            single_endpoint_failure
+                .visual_spans_for_range(0..complex_bidi.len())
+                .is_empty()
+        );
+        assert_eq!(
+            single_endpoint_failure.x_for_index_with_affinity_checked(
+                0,
+                gpui::CaretAffinity::Leading,
+            ),
+            None
+        );
+        assert_eq!(
+            single_endpoint_failure
+                .x_for_index_with_affinity(0, gpui::CaretAffinity::Leading),
+            px(0.),
+            "the scalar x API uses its documented fail-closed sentinel"
+        );
+
+        let both_failure = layout_line_with_geometry_fault(&text_system, "both", complex_bidi);
+        assert!(
+            both_failure.visual_cells.is_empty() && both_failure.carets.is_empty(),
+            "only simultaneous range and caret failure degrades bidi geometry"
+        );
+        assert!(
+            both_failure.has_bidi_runs && !both_failure.bidi_geometry_complete,
+            "both-source failure exposes degraded bidi geometry instead of a glyph fallback hit"
+        );
+        assert_eq!(both_failure.index_for_x(px(1.)), None);
+        assert!(both_failure.caret_for_x(px(1.)).is_none());
+        assert_eq!(both_failure.closest_index_for_x(px(1.)), both_failure.len);
+        assert!(
+            both_failure
+                .visual_spans_for_range(0..complex_bidi.len())
+                .is_empty(),
+            "degraded bidi selection cannot expose partial platform cells"
+        );
+        assert_eq!(
+            both_failure.x_for_index_with_affinity_checked(0, gpui::CaretAffinity::Leading),
+            None,
+            "degraded bidi caret x is explicitly unavailable"
+        );
+        let both_failure_wrap_text = format!("{complex_bidi} [both wrap]");
+        let both_failure_wrapped = {
+            let _guard = DiagnosticGeometryFaultGuard::new("both");
+            text_system
+                .shape_text(
+                    both_failure_wrap_text.clone().into(),
+                    px(16.),
+                    &[TextRun {
+                        len: both_failure_wrap_text.len(),
+                        ..Default::default()
+                    }],
+                    Some(px(45.)),
+                    None,
+                )
+                .unwrap()
+        };
+        assert!(
+            both_failure_wrapped[0].unwrapped_layout.has_bidi_runs
+                && !both_failure_wrapped[0]
+                    .unwrapped_layout
+                    .bidi_geometry_complete
+                && both_failure_wrapped[0].wrap_boundaries().is_empty(),
+            "degraded bidi lines still refuse legacy wrapping rather than reorder physical ink"
+        );
+        assert_eq!(
+            both_failure_wrapped[0].width(),
+            both_failure_wrapped[0].unwrapped_layout.width,
+            "refused bidi wrapping retains its complete unwrapped physical extent"
+        );
+        let ltr_under_fault = layout_line_with_geometry_fault(&text_system, "both", "ordinary LTR");
+        assert!(
+            ltr_under_fault.visual_cells.is_empty() && ltr_under_fault.carets.is_empty(),
+            "the odd-bidi gate leaves ordinary LTR outside the diagnostic hit-test seam"
+        );
+        assert!(ltr_under_fault.bidi_geometry_complete);
+
+        let mixed = "abcdאבגX";
+        let line = text_system.layout_line(
+            mixed,
+            px(16.),
+            &[TextRun {
+                len: mixed.len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        // Select the LTR suffix plus only the first two RTL scalars. The omitted final RTL
+        // scalar remains between those logical pieces in visual order, so DirectWrite must return
+        // two physical spans rather than an endpoint rectangle.
+        let two_rtl_scalars_end = "abcdאב".len();
+        let spans = line.visual_spans_for_range(1..two_rtl_scalars_end);
+        assert!(
+            spans.len() >= 2,
+            "mixed logical range must retain its discontiguous DirectWrite geometry: {spans:?}"
+        );
+        for caret in line
+            .carets
+            .iter()
+            .filter(|caret| caret.index == 4 || caret.index == 10)
+        {
+            let reverse = line.caret_for_x(caret.x).unwrap();
+            assert_eq!(
+                line.x_for_index_with_affinity_checked(reverse.index, reverse.affinity),
+                Some(caret.x),
+                "mixed bidi boundary preserves reverse-hit affinity"
+            );
+        }
+        let rtl_origins = line
+            .runs
+            .iter()
+            .flat_map(|run| run.glyphs.iter())
+            .filter(|glyph| (4.."abcdאבג".len()).contains(&glyph.index))
+            .map(|glyph| glyph.position.x)
+            .collect::<Vec<_>>();
+        assert!(
+            rtl_origins.windows(2).all(|pair| pair[0] > pair[1]),
+            "RTL glyph origins must descend in DirectWrite logical order: {rtl_origins:?}"
+        );
+
+        let pure_rtl = "אבגדה";
+        let pure_rtl_line = text_system.shape_line(
+            pure_rtl.into(),
+            px(16.),
+            &[TextRun {
+                len: pure_rtl.len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        assert_logical_and_physical_fragment("pure RTL", &pure_rtl_line);
+        let (rtl_left, rtl_right) = pure_rtl_line.split_at("אב".len());
+        assert_logical_and_physical_fragment("pure RTL split left", &rtl_left);
+        assert_logical_and_physical_fragment("pure RTL split right", &rtl_right);
+        assert_physical_bidi_order("pure RTL split left", &rtl_left, "אב");
+        assert_physical_bidi_order("pure RTL split right", &rtl_right, "גדה");
+        assert!(rtl_left.width() <= pure_rtl_line.width());
+        assert!(rtl_right.width() <= pure_rtl_line.width());
+        assert!(
+            rtl_left.width() + rtl_right.width() >= pure_rtl_line.width(),
+            "split physical paint extents are never understated"
+        );
+
+        let mixed_line = text_system.shape_line(
+            mixed.into(),
+            px(16.),
+            &[TextRun {
+                len: mixed.len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        let (mixed_left, mixed_right) = mixed_line.split_at("abcdאב".len());
+        assert_logical_and_physical_fragment("mixed split left", &mixed_left);
+        assert_logical_and_physical_fragment("mixed split right", &mixed_right);
+        assert!(mixed_left.width() <= mixed_line.width());
+        assert!(mixed_right.width() <= mixed_line.width());
+        assert!(
+            mixed_left.width() + mixed_right.width() >= mixed_line.width(),
+            "mixed split physical paint extents are never understated"
+        );
+
+        let wrapped = text_system
+            .shape_text(
+                format!("{pure_rtl} {mixed} {pure_rtl}").into(),
+                px(16.),
+                &[TextRun {
+                    len: format!("{pure_rtl} {mixed} {pure_rtl}").len(),
+                    ..Default::default()
+                }],
+                Some(px(45.)),
+                None,
+            )
+            .unwrap();
+        assert!(
+            wrapped[0].wrap_boundaries().is_empty(),
+            "legacy GPUI wrapping fails closed for platform-bidi lines until rows are reshaped"
+        );
+        assert_eq!(
+            wrapped[0].width(),
+            wrapped[0].unwrapped_layout.width,
+            "refused bidi wrapping does not understate the physical ink extent"
+        );
+        assert_physical_bidi_order("bidi wrap fallback", &wrapped[0].unwrapped_layout, pure_rtl);
+        assert_wrapped_row_coordinates("bidi wrap fail-closed", &wrapped[0]);
+
+        let trailing = text_system.layout_line(
+            "trailing   ",
+            px(16.),
+            &[TextRun {
+                len: "trailing   ".len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        let no_trailing = text_system.layout_line(
+            "trailing",
+            px(16.),
+            &[TextRun {
+                len: "trailing".len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        assert!(
+            trailing.width >= no_trailing.width,
+            "DirectWrite width includes trailing whitespace"
+        );
+
+        let long_ltr = "chat ".repeat(2_048);
+        let long_ltr_line = text_system.layout_line(
+            &long_ltr,
+            px(16.),
+            &[TextRun {
+                len: long_ltr.len(),
+                ..Default::default()
+            }],
+            None,
+        );
+        assert!(long_ltr_line.width.as_f32().is_finite());
+        assert!(
+            long_ltr_line.visual_cells.is_empty() && long_ltr_line.carets.is_empty(),
+            "ordinary long LTR text retains the established no-COM-hit-test fallback"
+        );
+        let long_ltr_wrapped = text_system
+            .shape_text(
+                long_ltr.clone().into(),
+                px(16.),
+                &[TextRun {
+                    len: long_ltr.len(),
+                    ..Default::default()
+                }],
+                Some(px(45.)),
+                None,
+            )
+            .unwrap();
+        assert!(
+            !long_ltr_wrapped[0].wrap_boundaries().is_empty(),
+            "the bidi fail-closed rule does not disable ordinary LTR wrapping"
+        );
+        println!(
+            "platform text geometry diagnostic passed: cells={}, carets={}, mixed_spans={spans:?}",
+            line.visual_cells.len(),
+            line.carets.len(),
+        );
+        cx.quit();
+    });
+}
+
+#[cfg(target_os = "windows")]
+fn layout_line_with_geometry_fault(
+    text_system: &gpui::WindowTextSystem,
+    fault: &str,
+    text: &str,
+) -> std::sync::Arc<gpui::LineLayout> {
+    let decorated_text = format!("{text} [{fault}]");
+    let _guard = DiagnosticGeometryFaultGuard::new(fault);
+    text_system.layout_line(
+        &decorated_text,
+        gpui::px(16.),
+        &[gpui::TextRun {
+            len: decorated_text.len(),
+            ..Default::default()
+        }],
+        None,
+    )
+}
+
+#[cfg(target_os = "windows")]
+struct DiagnosticGeometryFaultGuard(Option<std::ffi::OsString>);
+
+#[cfg(target_os = "windows")]
+impl DiagnosticGeometryFaultGuard {
+    fn new(fault: &str) -> Self {
+        let previous = std::env::var_os("GPUI_DIRECTWRITE_TEXT_GEOMETRY_FAULT");
+        // Rust 2024 marks process environment mutation unsafe. This non-test diagnostic is
+        // single-threaded and restores the prior value on every exit path through Drop.
+        unsafe { std::env::set_var("GPUI_DIRECTWRITE_TEXT_GEOMETRY_FAULT", fault) };
+        Self(previous)
+    }
+}
+
+#[cfg(target_os = "windows")]
+impl Drop for DiagnosticGeometryFaultGuard {
+    fn drop(&mut self) {
+        unsafe {
+            if let Some(previous) = self.0.take() {
+                std::env::set_var("GPUI_DIRECTWRITE_TEXT_GEOMETRY_FAULT", previous);
+            } else {
+                std::env::remove_var("GPUI_DIRECTWRITE_TEXT_GEOMETRY_FAULT");
+            }
+        }
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn assert_cluster_safe_geometry(text: &str, line: &gpui::LineLayout) {
+    use std::collections::BTreeSet;
+
+    let grapheme_boundaries = text
+        .grapheme_indices(true)
+        .map(|(offset, _)| offset)
+        .chain([text.len()])
+        .collect::<BTreeSet<_>>();
+    let directwrite_cluster_boundaries = line
+        .runs
+        .iter()
+        .flat_map(|run| run.glyphs.iter().map(|glyph| glyph.index))
+        .chain([0, text.len()])
+        .collect::<BTreeSet<_>>();
+    let editable_boundaries = grapheme_boundaries
+        .intersection(&directwrite_cluster_boundaries)
+        .copied()
+        .collect::<BTreeSet<_>>();
+
+    for cell in &line.visual_cells {
+        assert!(
+            editable_boundaries.contains(&cell.source.start)
+                && editable_boundaries.contains(&cell.source.end),
+            "{text:?}: visual cell {:?} exposes an internal shaping or grapheme offset",
+            cell.source
+        );
+    }
+    for caret in &line.carets {
+        assert!(
+            editable_boundaries.contains(&caret.index),
+            "{text:?}: reverse hit caret {} exposes an internal shaping or grapheme offset",
+            caret.index
+        );
+        let reverse = line.caret_for_x(caret.x).unwrap();
+        assert!(
+            editable_boundaries.contains(&reverse.index),
+            "{text:?}: reverse hit result {} exposes an internal shaping or grapheme offset",
+            reverse.index
+        );
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn assert_synthesized_carets_bound_cells(line: &gpui::LineLayout) {
+    for cell in &line.visual_cells {
+        let carets = line
+            .carets
+            .iter()
+            .filter(|caret| caret.index == cell.source.start || caret.index == cell.source.end)
+            .collect::<Vec<_>>();
+        assert!(
+            carets.iter().any(|caret| caret.x <= cell.visual.start)
+                && carets.iter().any(|caret| caret.x >= cell.visual.end),
+            "synthesized caret endpoints must bound every recovered range cell: {cell:?}"
+        );
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn assert_physical_bidi_order(label: &str, line: &gpui::LineLayout, rtl_text: &str) {
+    let rtl_origins = line
+        .runs
+        .iter()
+        .flat_map(|run| run.glyphs.iter())
+        .filter(|glyph| glyph.index < rtl_text.len())
+        .map(|glyph| glyph.position.x)
+        .collect::<Vec<_>>();
+    assert!(
+        rtl_origins.windows(2).all(|pair| pair[0] > pair[1]),
+        "{label}: physical RTL glyph origins remain descending, not logical-repainted: {rtl_origins:?}"
+    );
+}
+
+#[cfg(target_os = "windows")]
+fn assert_logical_and_physical_fragment(label: &str, line: &gpui::ShapedLine) {
+    assert!(
+        line.width().as_f32().is_finite() && line.width() >= gpui::px(0.),
+        "{label}: width"
+    );
+    let mut logical = line
+        .runs
+        .iter()
+        .flat_map(|run| run.glyphs.iter())
+        .collect::<Vec<_>>();
+    logical.sort_by_key(|glyph| glyph.index);
+    assert!(
+        logical
+            .windows(2)
+            .all(|pair| pair[0].logical_x <= pair[1].logical_x),
+        "{label}: source-order logical advances are monotonic"
+    );
+    for glyph in logical {
+        assert!(
+            glyph.position.x.as_f32().is_finite() && glyph.position.x >= gpui::px(0.),
+            "{label}: physical origin is finite and nonnegative"
+        );
+        assert!(
+            glyph.logical_x >= gpui::px(0.),
+            "{label}: logical coordinate is nonnegative"
+        );
+        assert!(
+            glyph.position.x <= line.width() + gpui::px(0.1)
+                && glyph.position.x + glyph.logical_advance <= line.width() + gpui::px(0.1),
+            "{label}: normalized physical extent stays inside logical fragment width"
+        );
+    }
+}
+
+#[cfg(target_os = "windows")]
+fn assert_wrapped_row_coordinates(label: &str, line: &gpui::WrappedLine) {
+    let layout = &line.unwrapped_layout;
+    let bidi_wrap_refused = line.wrap_boundaries().is_empty() && layout.has_bidi_runs;
+    let mut row_starts = vec![gpui::px(0.)];
+    row_starts.extend(
+        line.wrap_boundaries()
+            .iter()
+            .map(|boundary| layout.runs[boundary.run_ix].glyphs[boundary.glyph_ix].logical_x),
+    );
+    let mut previous_start = gpui::px(0.);
+    for (row_ix, row_start) in row_starts.iter().copied().enumerate() {
+        let row_end = row_starts.get(row_ix + 1).copied().unwrap_or(layout.width);
+        let width = row_end - row_start;
+        assert!(
+            row_start.as_f32().is_finite()
+                && row_end.as_f32().is_finite()
+                && row_start >= previous_start
+                && width >= gpui::px(0.)
+                && (bidi_wrap_refused || width <= line.width() + gpui::px(0.1)),
+            "{label}: wrapped foreground/background row {row_ix} has a bounded nonnegative logical width"
+        );
+        previous_start = row_start;
+    }
+    for glyph in layout.runs.iter().flat_map(|run| run.glyphs.iter()) {
+        assert!(
+            glyph.logical_x.as_f32().is_finite() && glyph.logical_x >= gpui::px(0.),
+            "{label}: wrapped glyph logical coordinate is finite and nonnegative"
+        );
+    }
+}
diff --git a/crates/gpui/examples/visual_range_spans.rs b/crates/gpui/examples/visual_range_spans.rs
new file mode 100644
index 0000000000..6468cff91a
--- /dev/null
+++ b/crates/gpui/examples/visual_range_spans.rs
@@ -0,0 +1,97 @@
+//! Non-test diagnostic for the `LineLayout::visual_spans_for_range` contract.
+//!
+//! Run with `cargo run -p gpui --example visual_range_spans`. It deliberately
+//! constructs visual glyph positions so the range algorithm can be checked
+//! without opening a window or relying on a platform text system.
+
+use gpui::{FontId, GlyphId, LineLayout, ShapedGlyph, ShapedRun, point, px};
+
+fn glyph(x: f32, index: usize) -> ShapedGlyph {
+    ShapedGlyph {
+        id: GlyphId(0),
+        position: point(px(x), px(0.)),
+        logical_x: px(x),
+        logical_advance: px(10.),
+        index,
+        is_emoji: false,
+    }
+}
+
+fn layout(width: f32, len: usize, glyphs: Vec<ShapedGlyph>) -> LineLayout {
+    LineLayout {
+        font_size: px(16.),
+        width: px(width),
+        ascent: px(12.),
+        descent: px(4.),
+        runs: vec![ShapedRun {
+            font_id: FontId(0),
+            glyphs,
+        }],
+        visual_cells: Vec::new(),
+        carets: Vec::new(),
+        has_bidi_runs: false,
+        bidi_geometry_complete: true,
+        len,
+    }
+}
+
+fn spans(layout: &LineLayout, range: std::ops::Range<usize>) -> Vec<(f32, f32)> {
+    layout
+        .visual_spans_for_range(range)
+        .into_iter()
+        .map(|span| (span.start.as_f32(), span.end.as_f32()))
+        .collect()
+}
+
+fn main() {
+    // Pure LTR remains one visual rectangle.
+    assert_eq!(
+        spans(
+            &layout(30., 3, vec![glyph(0., 0), glyph(10., 1), glyph(20., 2)]),
+            1..3
+        ),
+        vec![(10., 30.)]
+    );
+
+    // Pure RTL remains one visual rectangle despite descending source indices.
+    assert_eq!(
+        spans(
+            &layout(30., 3, vec![glyph(20., 0), glyph(10., 1), glyph(0., 2)]),
+            1..3
+        ),
+        vec![(0., 20.)]
+    );
+
+    // A logical range can skip the visually intervening third RTL cluster. The
+    // result must stay discontiguous instead of using logical endpoint bounds.
+    assert_eq!(
+        spans(
+            &layout(
+                80.,
+                12,
+                vec![
+                    glyph(0., 0),
+                    glyph(10., 1),
+                    glyph(20., 2),
+                    glyph(30., 3),
+                    glyph(60., 4),
+                    glyph(50., 6),
+                    glyph(40., 8),
+                    glyph(70., 10),
+                ],
+            ),
+            1..7,
+        ),
+        vec![(10., 40.), (50., 70.)]
+    );
+
+    // A single glyph cluster (ligature, combining sequence, or ZWJ sequence)
+    // owns its complete advance. Selecting inside its byte interval keeps the
+    // cluster whole rather than producing a zero-width endpoint rectangle.
+    assert_eq!(
+        spans(&layout(20., 8, vec![glyph(0., 0)]), 3..7),
+        vec![(0., 20.)]
+    );
+
+    println!("visual range span diagnostic passed");
+}
