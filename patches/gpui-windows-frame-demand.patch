+    ///
+    /// Before frame demand existed every window was invalidated on every
+    /// vsync, so a `WM_PAINT` was nearly always pending and a frame for new
+    /// input was drawn as soon as the input had been handled. Waiting for the
+    /// next vsync added up to a refresh period to the first frame after a
+    /// pause. This keeps the old pacing: a drawable, gated window with
+    /// demand that is due and no paint within the last refresh period paints
+    /// right away; otherwise the vsync thread paces it, so a window still
+    /// draws at most about once per refresh period.
+    pub(crate) fn take_for_immediate_paint(&self, now: Instant) -> bool {
+        if !self.gated.load(Ordering::SeqCst)
+            || self.hidden.load(Ordering::SeqCst)
+            || self.minimized.load(Ordering::SeqCst)
+            || !self.pending.load(Ordering::SeqCst)
+            || self.not_before.load(Ordering::SeqCst) != 0
+        {
+            return false;
+        }
+        let interval = Duration::from_nanos(VSYNC_INTERVAL_NANOS.load(Ordering::Relaxed));
+        if decode_not_before(self.last_paint.load(Ordering::SeqCst))
+            .is_some_and(|last_paint| now.saturating_duration_since(last_paint) < interval)
+        {
+            return false;
+        }
+        self.pending.swap(false, Ordering::SeqCst)
+    }
+
+    /// Asks for a `WM_PAINT` on the next vsync, dropping any not-before time,
+    /// and wakes the vsync thread if it sleeps and the window can draw.
+    pub(crate) fn request(&self) {
+        self.not_before.store(0, Ordering::SeqCst);
+        self.pending.store(true, Ordering::SeqCst);
+        self.wake();
+    }
+
+    /// Like [`Self::request`], but a frame already deferred to a not-before
+    /// time stays deferred. GPUI calls `schedule_frame` for every dirty window
+    /// at the end of every effect flush, and a throttled window stays dirty
+    /// until its deferred frame is drawn.
+    pub(crate) fn schedule(&self) {
+        if self.pending.load(Ordering::SeqCst) && self.not_before.load(Ordering::SeqCst) != 0 {
+            return;
+        }
+        self.request();
+    }
+
+    /// Holds the window's frame until `not_before`, for a frame GPUI's
+    /// frame-rate throttle deferred. It replaces whatever was pending: the
+    /// requests made for the frame GPUI just deferred (an effect flush at the
+    /// start of the frame request re-schedules every window with demand) must
+    /// not make it due again on the next vsync. Demand that arrives later
+    /// still overrides it through [`Self::request`].
+    pub(crate) fn defer_until(&self, not_before: Instant) {
+        self.not_before
+            .store(encode_not_before(not_before), Ordering::SeqCst);
+        self.pending.store(true, Ordering::SeqCst);
+        // The sleeping thread recomputes its wake-up time.
+        self.wake();
+    }
+
+    /// Asks for a `WM_PAINT` on the first vsync at or after `not_before`. A
+    /// pending request that is due earlier stays as it is.
+    pub(crate) fn request_after(&self, not_before: Instant) {
+        let encoded = encode_not_before(not_before);
+        if self.pending.load(Ordering::SeqCst) {
+            self.not_before.fetch_min(encoded, Ordering::SeqCst);
+        } else {
+            self.not_before.store(encoded, Ordering::SeqCst);
+        }
+        self.pending.store(true, Ordering::SeqCst);
+        // The sleeping thread recomputes its wake-up time.
+        self.wake();
+    }
+
+    pub(crate) fn set_gated(&self, gated: bool) {
+        self.gated.store(gated, Ordering::SeqCst);
+        if !gated {
+            VSYNC_SLEEP.wake();
+        }
+    }
+
+    pub(crate) fn set_hidden(&self, hidden: bool) {
+        self.hidden.store(hidden, Ordering::SeqCst);
+        if !hidden {
+            self.request();
+        }
+    }
+
+    pub(crate) fn set_minimized(&self, minimized: bool) {
+        self.minimized.store(minimized, Ordering::SeqCst);
+        if !minimized {
+            self.request();
+        }
+    }
+
+    fn wake(&self) {
+        if !self.hidden.load(Ordering::SeqCst) && !self.minimized.load(Ordering::SeqCst) {
+            VSYNC_SLEEP.wake();
+        }
+    }
+
+    fn is_due(&self, now: Instant) -> bool {
+        decode_not_before(self.not_before.load(Ordering::SeqCst))
+            .is_none_or(|not_before| now + DEADLINE_TOLERANCE >= not_before)
+    }
+
+    /// Whether this window needs a vsync now: it is ungated, or it is
+    /// drawable and has demand that is due.
+    pub(crate) fn wants_vsync(&self, drawable: bool, now: Instant) -> bool {
+        !self.gated.load(Ordering::SeqCst)
+            || (drawable && self.pending.load(Ordering::SeqCst) && self.is_due(now))
+    }
+
+    /// When this drawable window's deferred frame becomes due, if it has one.
+    pub(crate) fn deferred_until(&self, drawable: bool) -> Option<Instant> {
+        if !drawable || !self.gated.load(Ordering::SeqCst) || !self.pending.load(Ordering::SeqCst) {
+            return None;
+        }
+        decode_not_before(self.not_before.load(Ordering::SeqCst))
+    }
+
+    /// Decides one vsync for this window. `drawable` is false for a hidden or
+    /// minimized window, which keeps its demand until it can draw again (it
+    /// receives no `WM_PAINT` meanwhile). A deferred frame stays pending until
+    /// it is due. `safety_frame` invalidates a drawable window without
+    /// consuming its demand.
+    pub(crate) fn on_vsync(
+        &self,
+        drawable: bool,
+        safety_frame: bool,
+        now: Instant,
+    ) -> VSyncWindowAction {
+        if !self.gated.load(Ordering::SeqCst) {
+            self.pending.store(false, Ordering::SeqCst);
+            return VSyncWindowAction {
+                invalidate: true,
+                delivered: true,
+            };
+        }
+        if !drawable {
+            return VSyncWindowAction {
+                invalidate: false,
+                delivered: false,
+            };
+        }
+        let delivered = self.pending.load(Ordering::SeqCst)
+            && self.is_due(now)
+            && self.pending.swap(false, Ordering::SeqCst);
+        VSyncWindowAction {
+            invalidate: delivered || safety_frame,
+            delivered,
+        }
+    }
+}
+
+/// Serves one `WM_PAINT`: the window's update region is validated before the
+/// frame is drawn, never after. Drawing re-arms the demand of a window that
+/// keeps animating, and the vsync thread may consume that demand and
+/// invalidate the window before the draw returns; validating afterwards would
+/// erase that invalidation while GPUI still thinks a frame is on its way.
+pub(crate) fn serve_paint<R>(validate: impl FnOnce(), draw: impl FnOnce() -> R) -> R {
+    validate();
+    draw()
+}
