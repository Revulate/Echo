diff --git a/crates/gpui/examples/frame_demand.rs b/crates/gpui/examples/frame_demand.rs
new file mode 100644
index 0000000000..338e1cb82e
--- /dev/null
+++ b/crates/gpui/examples/frame_demand.rs
@@ -0,0 +1,182 @@
+#![cfg_attr(target_family = "wasm", no_main)]
+
+//! A window for checking demand-driven frames (`Window::set_frame_demand_gating`).
+//!
+//! By default it shows static content, so an idle window should cost no
+//! frames. `--tick` notifies the view from a timer twice a second, and
+//! `--fps <n>` does so `n` times a second; either must keep the counter
+//! advancing while the window is otherwise idle. `--animate` requests an
+//! animation frame on every render, which must keep the render counter
+//! climbing (at the display rate while focused, at the inactive-window cap
+//! while not). `--no-gating` restores a frame request on every vsync.
+//!
+//! `--report <seconds>` prints, after that long, how late each timer
+//! notification was rendered and how evenly those renders were spaced, then
+//! quits.
+
+#[path = "example_support/fonts.rs"]
+mod example_support;
+
+use std::time::{Duration, Instant};
+
+use gpui::{
+    App, Bounds, Context, Window, WindowBounds, WindowOptions, div, prelude::*, px, rgb, size,
+};
+use gpui_platform::application;
+
+struct FrameDemand {
+    animate: bool,
+    ticks: u64,
+    renders: u64,
+    /// When the oldest notification not yet rendered was sent.
+    notified_at: Option<Instant>,
+    /// Notification-to-render delays and the render times that served them.
+    delays: Vec<Duration>,
+    served_at: Vec<Instant>,
+}
+
+impl Render for FrameDemand {
+    fn render(&mut self, window: &mut Window, _cx: &mut Context<Self>) -> impl IntoElement {
+        self.renders += 1;
+        if let Some(notified_at) = self.notified_at.take() {
+            let now = Instant::now();
+            self.delays.push(now - notified_at);
+            self.served_at.push(now);
+        }
+        if self.animate {
+            window.request_animation_frame();
+        }
+        div()
+            .flex()
+            .flex_col()
+            .gap_3()
+            .size_full()
+            .justify_center()
+            .items_center()
+            .bg(rgb(0x202830))
+            .text_xl()
+            .text_color(rgb(0xffffff))
+            .child(format!("Ticks: {}", self.ticks))
+            .child(format!("Renders: {}", self.renders))
+    }
+}
+
+impl FrameDemand {
+    fn report(&self) {
+        fn millis(duration: Duration) -> f64 {
+            duration.as_secs_f64() * 1000.0
+        }
+        fn summary(mut values: Vec<f64>) -> String {
+            if values.is_empty() {
+                return "n=0".into();
+            }
+            values.sort_by(f64::total_cmp);
+            let n = values.len();
+            let mean = values.iter().sum::<f64>() / n as f64;
+            let sd = (values.iter().map(|v| (v - mean).powi(2)).sum::<f64>() / n as f64).sqrt();
+            let at = |q: f64| values[((n - 1) as f64 * q).round() as usize];
+            format!(
+                "n={n} mean={mean:.2} sd={sd:.2} p50={:.2} p95={:.2} max={:.2}",
+                at(0.5),
+                at(0.95),
+                values[n - 1]
+            )
+        }
+        let delays = self.delays.iter().map(|d| millis(*d)).collect();
+        let intervals = self
+            .served_at
+            .windows(2)
+            .map(|pair| millis(pair[1] - pair[0]))
+            .collect();
+        println!("notify_to_render_ms {}", summary(delays));
+        println!("render_interval_ms {}", summary(intervals));
+    }
+}
+
+fn run_example() {
+    application().run(|cx: &mut App| {
+        if !example_support::load_fonts(cx) {
+            return;
+        }
+        let arguments: Vec<String> = std::env::args().collect();
+        let has_flag = |flag: &str| arguments.iter().any(|argument| argument == flag);
+        let value = |flag: &str| {
+            arguments
+                .iter()
+                .position(|argument| argument == flag)
+                .and_then(|index| arguments.get(index + 1))
+                .and_then(|value| value.parse::<f64>().ok())
+        };
+        let animate = has_flag("--animate");
+        let tick_hz = value("--fps").or(has_flag("--tick").then_some(2.0));
+        let report_after = value("--report").map(Duration::from_secs_f64);
+        let gating = !has_flag("--no-gating");
+        let bounds = Bounds::centered(None, size(px(400.), px(300.)), cx);
+        cx.open_window(
+            WindowOptions {
+                window_bounds: Some(WindowBounds::Windowed(bounds)),
+                ..Default::default()
+            },
+            |window, cx| {
+                window.set_frame_demand_gating(gating);
+                cx.new(|cx| {
+                    if let Some(tick_hz) = tick_hz {
+                        let period = Duration::from_secs_f64(1.0 / tick_hz);
+                        cx.spawn(async move |this, cx| {
+                            let started = Instant::now();
+                            let mut next = started + period;
+                            loop {
+                                let now = Instant::now();
+                                cx.background_executor()
+                                    .timer(next.saturating_duration_since(now))
+                                    .await;
+                                next += period;
+                                let done =
+                                    report_after.is_some_and(|after| started.elapsed() >= after);
+                                if this
+                                    .update(cx, |this: &mut FrameDemand, cx| {
+                                        if done {
+                                            this.report();
+                                            cx.quit();
+                                            return;
+                                        }
+                                        this.ticks += 1;
+                                        this.notified_at.get_or_insert_with(Instant::now);
+                                        cx.notify();
+                                    })
+                                    .is_err()
+                                    || done
+                                {
+                                    break;
+                                }
+                            }
+                        })
+                        .detach();
+                    }
+                    FrameDemand {
+                        animate,
+                        ticks: 0,
+                        renders: 0,
+                        notified_at: None,
+                        delays: Vec::new(),
+                        served_at: Vec::new(),
+                    }
+                })
+            },
+        )
+        .unwrap();
+        cx.activate(true);
+    });
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn main() {
+    run_example();
+}
+
+#[cfg(target_family = "wasm")]
+#[wasm_bindgen::prelude::wasm_bindgen(start)]
+pub fn start() {
+    gpui_platform::web_init();
+    run_example();
+}
