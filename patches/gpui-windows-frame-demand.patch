+/// What the vsync thread does after a vsync.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum AfterVSync {
+    /// Wait for the next vsync.
+    Tick,
+    /// Sleep until this time or until a request wakes the thread.
+    Sleep(Instant),
+}
+
+/// The vsync thread's timing decisions, apart from the windows themselves.
+pub(crate) struct VSyncSchedule {
+    last_safety_frame: Instant,
+    last_delivery: Instant,
+}
+
+impl VSyncSchedule {
+    pub(crate) fn new(now: Instant) -> Self {
+        Self {
+            last_safety_frame: now,
+            last_delivery: now,
+        }
+    }
+
+    /// Whether this vsync carries a safety frame.
+    pub(crate) fn take_safety_frame(&mut self, now: Instant) -> bool {
+        let due = now.saturating_duration_since(self.last_safety_frame) >= SAFETY_FRAME_INTERVAL;
+        if due {
+            self.last_safety_frame = now;
+        }
+        due
+    }
+
+    /// Decides what follows a vsync on which `delivered` says whether any
+    /// window's demand was served, `busy` whether something else needs every
+    /// vsync (a device-loss recovery), and `next_deferred` the earliest time a
+    /// deferred frame becomes due.
+    pub(crate) fn after_vsync(
+        &mut self,
+        now: Instant,
+        delivered: bool,
+        busy: bool,
+        next_deferred: Option<Instant>,
+    ) -> AfterVSync {
+        if delivered || busy {
+            self.last_delivery = now;
+            return AfterVSync::Tick;
+        }
+        if now.saturating_duration_since(self.last_delivery) < VSYNC_GRACE {
+            return AfterVSync::Tick;
+        }
+        let safety = self.last_safety_frame + SAFETY_FRAME_INTERVAL;
+        AfterVSync::Sleep(next_deferred.map_or(safety, |deferred| deferred.min(safety)))
+    }
+}
+
+/// Lets the vsync thread sleep while no window wants a frame. A
+/// [`FrameDemand::request`] wakes it.
+struct VSyncSleep {
+    /// The registration of the sleeping vsync thread, or 0. Only a thread that
+    /// finds it 0 may set it, and only the thread that set it clears it, so a
+    /// stopped thread winding down after a new one started cannot hide the new
+    /// thread's sleep from requests.
+    sleeping: AtomicU64,
+    thread: Mutex<Option<Thread>>,
+}
+
+static VSYNC_SLEEP: VSyncSleep = VSyncSleep {
+    sleeping: AtomicU64::new(0),
+    thread: Mutex::new(None),
+};
+
+static NEXT_VSYNC_REGISTRATION: AtomicU64 = AtomicU64::new(1);
+
+impl VSyncSleep {
+    fn wake(&self) {
+        if self.sleeping.load(Ordering::SeqCst) != 0 {
+            self.unpark();
+        }
+    }
+
+    fn unpark(&self) {
+        if let Some(thread) = self
+            .thread
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .as_ref()
+        {
+            thread.unpark();
+        }
+    }
+}
+
+/// Registers the calling thread as the vsync thread that demand wakes, and
+/// returns its registration for [`sleep_until_demand`].
+pub(crate) fn register_vsync_thread() -> u64 {
+    *VSYNC_SLEEP.thread.lock().unwrap_or_else(|e| e.into_inner()) = Some(std::thread::current());
+    NEXT_VSYNC_REGISTRATION.fetch_add(1, Ordering::Relaxed)
+}
+
+/// Wakes the vsync thread unconditionally (to make it notice a stop request).
+pub(crate) fn wake_vsync_thread() {
+    VSYNC_SLEEP.unpark();
+}
+
+/// Sleeps the vsync thread until `deadline` or until a window has demand.
+/// `has_demand` is re-checked after the thread announces that it sleeps, so a
+/// request racing with the decision to sleep is never lost: either the check
+/// sees it, or the request sees `sleeping` and unparks the thread. The thread
+/// may also return early (a spurious or stale unpark, or another thread's mark
+/// still set); callers loop anyway.
+pub(crate) fn sleep_until_demand(
+    registration: u64,
+    deadline: Instant,
+    has_demand: impl Fn() -> bool,
+) {
+    if VSYNC_SLEEP
+        .sleeping
+        .compare_exchange(0, registration, Ordering::SeqCst, Ordering::SeqCst)
+        .is_err()
+    {
+        return;
+    }
+    if !has_demand() {
+        let now = Instant::now();
+        if deadline > now {
+            std::thread::park_timeout(deadline - now);
+        }
+    }
+    let _ =
+        VSYNC_SLEEP
+            .sleeping
+            .compare_exchange(registration, 0, Ordering::SeqCst, Ordering::SeqCst);
+}
