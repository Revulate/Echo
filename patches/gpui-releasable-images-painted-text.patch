diff --git a/crates/gpui_windows/src/shaders.hlsl b/crates/gpui_windows/src/shaders.hlsl
index 2f9a00c418..0654369af3 100644
--- a/crates/gpui_windows/src/shaders.hlsl
+++ b/crates/gpui_windows/src/shaders.hlsl
@@ -1266,3 +1266,295 @@ float4 polychrome_sprite_fragment(PolychromeSpriteFragmentInput input): SV_Targe
     color.a *= sprite.opacity * saturate(0.5 - distance);
     return color;
 }
+
+/*
+**
+**              Painted text (local Echo extension)
+**
+**  Rebuilds Echo's CPU 7TV name-paint compositor per pixel of a padded
+**  canvas: stroke rings, then the fill, drawn source-over through the glyph
+**  mask, then each drop shadow destination-over with its precomputed blurred
+**  weight. The mask tile stacks 1 + shadow_count blocks of canvas_height rows
+**  (block 0 is the glyph coverage). Colors are premultiplied RGBA in 0..1
+**  except gradient stops, which are straight RGBA in 0..255 like the CPU's u8
+**  colors, so stop interpolation rounds the same way.
+**
+*/
+
+static const uint PAINTED_TEXT_LAYER_SOLID = 1u;
+static const uint PAINTED_TEXT_LAYER_LINEAR = 2u;
+static const uint PAINTED_TEXT_LAYER_CIRCLE = 3u;
+static const uint PAINTED_TEXT_LAYER_ELLIPSE = 4u;
+static const uint PAINTED_TEXT_LAYER_IMAGE = 5u;
+static const float PAINTED_TEXT_EPSILON = 1.1920929e-7;
+
+struct PaintedTextLayer {
+    uint kind;
+    uint repeat;
+    uint stop_start;
+    uint stop_count;
+    float opacity;
+    float4 params;
+    float4 solid;
+};
+
+struct PaintedTextStop {
+    float at;
+    float4 color;
+};
+
+struct PaintedText {
+    uint order;
+    uint layer_count;
+    Bounds bounds;
+    Bounds content_mask;
+    AtlasTile mask_tile;
+    AtlasTile fill_tile;
+    uint canvas_height;
+    uint shadow_count;
+    uint ring_count;
+    uint has_fill_texture;
+    uint use_fallback;
+    float opacity;
+    float2 fill_origin;
+    float2 box_size;
+    float4 base_color;
+    float4 fallback_color;
+    float4 stroke_color;
+    int2 ring_offsets[8];
+    float4 shadow_colors[8];
+    PaintedTextLayer layers[4];
+    PaintedTextStop stops[16];
+};
+
+struct PaintedTextVertexOutput {
+    nointerpolation uint text_id: TEXCOORD0;
+    float4 position: SV_Position;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+struct PaintedTextFragmentInput {
+    nointerpolation uint text_id: TEXCOORD0;
+    float4 position: SV_Position;
+};
+
+StructuredBuffer<PaintedText> painted_texts: register(t1);
+Texture2D<float4> t_paint_fill: register(t2);
+
+PaintedTextVertexOutput painted_text_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    uint text_id = batch_start_index + instance_id;
+    Bounds bounds = painted_texts[text_id].bounds;
+
+    PaintedTextVertexOutput output;
+    output.position = to_device_position(unit_vertex, bounds);
+    output.clip_distance = distance_from_clip_rect(unit_vertex, bounds, painted_texts[text_id].content_mask);
+    output.text_id = text_id;
+    return output;
+}
+
+// Coverage or shadow weight at canvas pixel `p` of `block`; zero outside.
+float painted_mask_value(uint id, int2 p, uint block) {
+    AtlasTile tile = painted_texts[id].mask_tile;
+    int height = int(painted_texts[id].canvas_height);
+    if (p.x < 0 || p.y < 0 || p.x >= tile.bounds.size.x || p.y >= height) {
+        return 0.0;
+    }
+    int2 texel = tile.bounds.origin + int2(p.x, p.y + int(block) * height);
+    return t_sprite.Load(int3(texel, 0)).r;
+}
+
+float4 painted_src_over(float4 dst, float4 src, float weight) {
+    return src * weight + dst * (1.0 - src.a * weight);
+}
+
+float4 painted_dst_over(float4 dst, float4 src, float weight) {
+    return dst + src * weight * (1.0 - dst.a);
+}
+
+// A straight 0..255 color as premultiplied 0..1.
+float4 painted_premultiply(float4 color) {
+    float alpha = color.a / 255.0;
+    return float4(color.rgb / 255.0 * alpha, alpha);
+}
+
+// f32::round (half away from zero) for the non-negative values used here;
+// HLSL round() rounds halves to even.
+float3 painted_round3(float3 value) {
+    return floor(value + 0.5);
+}
+
+// RgbaColor::lerp: premultiplied interpolation rounded to u8 channels.
+float4 painted_lerp_stop(float4 from, float4 to, float t) {
+    t = saturate(t);
+    float from_alpha = from.a / 255.0;
+    float to_alpha = to.a / 255.0;
+    float alpha = from_alpha + (to_alpha - from_alpha) * t;
+    if (alpha <= PAINTED_TEXT_EPSILON) {
+        return float4(0.0, 0.0, 0.0, 0.0);
+    }
+    float3 a = from.rgb * from_alpha;
+    float3 b = to.rgb * to_alpha;
+    float3 rgb = clamp(painted_round3((a + (b - a) * t) / alpha), 0.0, 255.0);
+    return float4(rgb, clamp(floor(alpha * 255.0 + 0.5), 0.0, 255.0));
+}
+
+// sample_gradient_stops.
+float4 painted_sample_stops(uint id, uint start, uint count, float ratio) {
+    ratio = saturate(ratio);
+    PaintedTextStop first = painted_texts[id].stops[start];
+    if (ratio <= first.at) {
+        return first.color;
+    }
+    [loop]
+    for (uint i = 0u; i + 1u < count; i++) {
+        PaintedTextStop left = painted_texts[id].stops[start + i];
+        PaintedTextStop right = painted_texts[id].stops[start + i + 1u];
+        if (ratio <= right.at) {
+            float span = abs(right.at - left.at);
+            float t = span <= PAINTED_TEXT_EPSILON ? 0.0 : (ratio - left.at) / (right.at - left.at);
+            return painted_lerp_stop(left.color, right.color, t);
+        }
+    }
+    return painted_texts[id].stops[start + count - 1u].color;
+}
+
+// repeating_gradient_ratio.
+float painted_repeating_ratio(uint id, uint start, uint count, float ratio) {
+    float first = painted_texts[id].stops[start].at;
+    float last = painted_texts[id].stops[start + count - 1u].at;
+    float period = last - first;
+    if (period <= PAINTED_TEXT_EPSILON) {
+        return saturate(ratio);
+    }
+    float offset = ratio - first;
+    return first + (offset - period * floor(offset / period));
+}
+
+// A premultiplied fill-texture texel, wrapped or clamped to the tile.
+float4 painted_fill_texel(AtlasTile tile, int x, int y, bool repeat) {
+    int2 size = max(tile.bounds.size, int2(1, 1));
+    if (repeat) {
+        x = ((x % size.x) + size.x) % size.x;
+        y = ((y % size.y) + size.y) % size.y;
+    } else {
+        x = clamp(x, 0, size.x - 1);
+        y = clamp(y, 0, size.y - 1);
+    }
+    float4 color = t_paint_fill.Load(int3(tile.bounds.origin + int2(x, y), 0));
+    return float4(color.rgb * color.a, color.a);
+}
+
+// sample_image_fill: the texture stretched over the paint box, bilinear in
+// premultiplied space.
+float4 painted_sample_image(uint id, float2 p, bool repeat) {
+    AtlasTile tile = painted_texts[id].fill_tile;
+    float2 f = p / painted_texts[id].box_size;
+    if (repeat) {
+        f = f - floor(f);
+    } else {
+        f = saturate(f);
+    }
+    int2 size = max(tile.bounds.size, int2(1, 1));
+    float2 s = f * float2(size) - 0.5;
+    float2 s0 = floor(s);
+    float2 t = s - s0;
+    int x0 = int(s0.x);
+    int y0 = int(s0.y);
+    float4 p00 = painted_fill_texel(tile, x0, y0, repeat);
+    float4 p10 = painted_fill_texel(tile, x0 + 1, y0, repeat);
+    float4 p01 = painted_fill_texel(tile, x0, y0 + 1, repeat);
+    float4 p11 = painted_fill_texel(tile, x0 + 1, y0 + 1, repeat);
+    float4 top = p00 + (p10 - p00) * t.x;
+    float4 bottom = p01 + (p11 - p01) * t.x;
+    return top + (bottom - top) * t.y;
+}
+
+// fill_color_at: the paint's layers composited at paint-box position `p`.
+float4 painted_fill_color(uint id, float2 p) {
+    float4 base = painted_texts[id].base_color;
+    float4 result = float4(0.0, 0.0, 0.0, 0.0);
+    bool any = false;
+    // A paint whose layers never contribute uses its representative color.
+    uint layer_count = painted_texts[id].use_fallback != 0u ? 0u : painted_texts[id].layer_count;
+    [loop]
+    for (uint l = 0u; l < layer_count; l++) {
+        PaintedTextLayer layer = painted_texts[id].layers[l];
+        if (layer.opacity <= 0.0) {
+            continue;
+        }
+        if (layer.kind == PAINTED_TEXT_LAYER_IMAGE) {
+            float4 color = base;
+            if (painted_texts[id].has_fill_texture != 0u) {
+                color = painted_src_over(color, painted_sample_image(id, p, layer.repeat != 0u), 1.0);
+            }
+            result = painted_src_over(result, color, layer.opacity);
+            any = true;
+            continue;
+        }
+        if (layer.stop_count == 0u) {
+            continue;
+        }
+        if (layer.kind == PAINTED_TEXT_LAYER_SOLID) {
+            result = painted_src_over(result, layer.solid, 1.0);
+            any = true;
+            continue;
+        }
+        float ratio = 0.0;
+        if (layer.kind == PAINTED_TEXT_LAYER_LINEAR) {
+            ratio = abs(layer.params.w) <= PAINTED_TEXT_EPSILON
+                ? 0.5
+                : (p.x * layer.params.x + p.y * layer.params.y - layer.params.z) / layer.params.w;
+        } else if (layer.kind == PAINTED_TEXT_LAYER_CIRCLE) {
+            ratio = length(p - layer.params.xy) / layer.params.z;
+        } else if (layer.kind == PAINTED_TEXT_LAYER_ELLIPSE) {
+            ratio = length((p - layer.params.xy) / layer.params.zw);
+        } else {
+            continue;
+        }
+        ratio = layer.repeat != 0u
+            ? painted_repeating_ratio(id, layer.stop_start, layer.stop_count, ratio)
+            : saturate(ratio);
+        float4 stop = painted_sample_stops(id, layer.stop_start, layer.stop_count, ratio);
+        float4 color = painted_src_over(base, painted_premultiply(stop), 1.0);
+        result = painted_src_over(result, color, layer.opacity);
+        any = true;
+    }
+    return any ? result : painted_texts[id].fallback_color;
+}
+
+float4 painted_text_fragment(PaintedTextFragmentInput input): SV_Target {
+    uint id = input.text_id;
+    int2 c = int2(floor(input.position.xy - painted_texts[id].bounds.origin));
+    float4 canvas = float4(0.0, 0.0, 0.0, 0.0);
+
+    float4 stroke = painted_texts[id].stroke_color;
+    uint ring_count = painted_texts[id].ring_count;
+    [loop]
+    for (uint i = 0u; i < ring_count; i++) {
+        float ring = painted_mask_value(id, c - painted_texts[id].ring_offsets[i], 0u);
+        if (ring > 0.0) {
+            canvas = painted_src_over(canvas, stroke, ring);
+        }
+    }
+
+    float coverage = painted_mask_value(id, c, 0u);
+    if (coverage > 0.0) {
+        float2 p = float2(c) + painted_texts[id].fill_origin;
+        canvas = painted_src_over(canvas, painted_fill_color(id, p), coverage);
+    }
+
+    uint shadow_count = painted_texts[id].shadow_count;
+    [loop]
+    for (uint k = 0u; k < shadow_count; k++) {
+        float weight = painted_mask_value(id, c, k + 1u);
+        if (weight > 0.0) {
+            canvas = painted_dst_over(canvas, painted_texts[id].shadow_colors[k], weight);
+        }
+    }
+
+    if (canvas.a <= 0.0) {
+        return float4(0.0, 0.0, 0.0, 0.0);
+    }
+    return float4(canvas.rgb / canvas.a, canvas.a * painted_texts[id].opacity);
+}
