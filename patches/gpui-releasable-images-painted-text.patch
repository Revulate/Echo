+
+impl PaintMask {
+    /// `None` when `data` is not exactly `width * block_height * blocks` bytes.
+    pub fn new(width: u32, block_height: u32, blocks: u32, data: Vec<u8>) -> Option<Self> {
+        static NEXT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
