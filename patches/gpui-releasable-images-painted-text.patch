+    pub at: f32,
+    pub color: [f32; 4],
+}
+
+/// Text painted with a 7TV-style name paint (local Echo extension).
+///
+/// The shader rebuilds the CPU compositor's result per pixel of a padded
+/// canvas: stroke rings and the fill drawn source-over through the glyph mask,
+/// then each drop shadow destination-over with its precomputed blurred weight.
+/// The mask tile stacks `1 + shadow_count` blocks of `canvas_height` rows:
+/// block 0 is the glyph coverage, block `k` the weight of shadow `k - 1`.
+/// Colors are premultiplied RGBA in `0..=1` unless noted.
+#[derive(Clone, Copy, Debug)]
+#[repr(C)]
+#[expect(missing_docs)]
+pub struct PaintedText {
+    pub order: DrawOrder,
+    pub layer_count: u32,
+    pub bounds: Bounds<ScaledPixels>,
+    pub content_mask: ContentMask<ScaledPixels>,
+    pub mask_tile: AtlasTile,
+    pub fill_tile: AtlasTile,
+    pub canvas_height: u32,
+    pub shadow_count: u32,
+    pub ring_count: u32,
+    pub has_fill_texture: u32,
+    pub use_fallback: u32,
+    pub opacity: f32,
+    /// Added to a canvas pixel index to get its paint-box position (pixel center).
+    pub fill_origin: [f32; 2],
+    pub box_size: [f32; 2],
+    pub base_color: [f32; 4],
+    pub fallback_color: [f32; 4],
+    pub stroke_color: [f32; 4],
+    pub ring_offsets: [[i32; 2]; PAINTED_TEXT_MAX_RINGS],
+    pub shadow_colors: [[f32; 4]; PAINTED_TEXT_MAX_SHADOWS],
+    pub layers: [PaintedTextLayer; PAINTED_TEXT_MAX_LAYERS],
+    pub stops: [PaintedTextStop; PAINTED_TEXT_MAX_STOPS],
+}
+
+// The HLSL `PaintedText` in gpui_windows/src/shaders.hlsl reads this layout
+// from a structured buffer, field for field with 4-byte packing.
+const _: () = assert!(std::mem::size_of::<PaintedText>() == 912);
+
+impl PaintedText {
+    fn textures(&self) -> (AtlasTextureId, AtlasTextureId) {
+        (self.mask_tile.texture_id, self.fill_tile.texture_id)
+    }
+
+    pub(crate) fn sort_key(&self) -> (DrawOrder, u32, u32, u32, u32) {
+        (
+            self.order,
+            self.mask_tile.texture_id.index,
+            self.fill_tile.texture_id.index,
+            self.fill_tile.texture_id.kind as u32,
+            self.mask_tile.tile_id.0,
+        )
+    }
+}
+
+impl Default for PaintedText {
+    /// An empty instance with opacity 1; the window fills in tiles and bounds.
+    fn default() -> Self {
+        let tile = AtlasTile {
+            texture_id: AtlasTextureId {
+                index: 0,
+                kind: crate::AtlasTextureKind::Monochrome,
+            },
+            tile_id: crate::TileId(0),
+            padding: 0,
+            bounds: Bounds::default(),
+        };
