+///
+/// A releasable image ([`RenderImage::new_releasable`]) uploads its resident
+/// pixels, or rebuilds them when a lost device or a window opened later needs
+/// them after the release. It drops its CPU copy once a tile exists, but only
+/// while a single window is open, so windows showing the same image do not
+/// each rebuild it. `Ok(None)` when a released image cannot rebuild its pixels.
+fn image_atlas_tile(
+    atlas: &dyn PlatformAtlas,
+    data: &RenderImage,
+    frame_index: usize,
+) -> Result<Option<AtlasTile>> {
+    let params = RenderImageParams {
+        image_id: data.id,
+        frame_index,
+    };
+    let resident = data.lock_resident_pixels();
+    let tile = atlas.get_or_insert_with(params.into(), &mut || {
+        let bytes = if let Some(bytes) = data.as_bytes(frame_index) {
+            Cow::Borrowed(bytes)
+        } else if let Some(bytes) = resident.as_ref().and_then(|pixels| pixels.as_deref()) {
+            Cow::Borrowed(bytes)
+        } else if let Some(bytes) = data.rebuild_pixels(frame_index) {
+            Cow::Owned(bytes)
+        } else {
+            return Ok(None);
+        };
+        Ok(Some((data.size(frame_index), bytes)))
+    })?;
+    drop(resident);
+    if tile.is_some() && OPEN_WINDOWS.load(std::sync::atomic::Ordering::Relaxed) <= 1 {
+        data.release_pixels();
+    }
