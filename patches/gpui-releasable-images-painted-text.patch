+    #[test]
+    fn releasable_image_rebuilds_after_release() {
+        let image = RenderImage::new_releasable(
+            1,
+            1,
+            Delay::from_numer_denom_ms(50, 1),
+            vec![1, 2, 3, 4],
+            Arc::new(|| Some(vec![5, 6, 7, 8])),
+        );
+        assert_eq!(image.frame_count(), 1);
+        assert_eq!(image.size(0), size(1.into(), 1.into()));
+        assert_eq!(image.byte_len(0), 4);
+        assert_eq!(image.as_bytes(0), None);
+        assert_eq!(
+            image.with_pixels(0, |bytes| bytes.to_vec()),
+            Some(vec![1, 2, 3, 4])
+        );
+        image.release_pixels();
+        assert!(!image.has_resident_pixels());
+        assert_eq!(
+            image.with_pixels(0, |bytes| bytes.to_vec()),
+            Some(vec![5, 6, 7, 8])
+        );
+        assert_eq!(image.with_pixels(1, |bytes| bytes.len()), None);
+    }
 }
