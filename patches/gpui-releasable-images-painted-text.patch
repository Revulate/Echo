+/// Most fill layers a [`PaintedText`] carries.
+pub const PAINTED_TEXT_MAX_LAYERS: usize = 4;
+/// Most gradient stops a [`PaintedText`] carries across its layers.
+pub const PAINTED_TEXT_MAX_STOPS: usize = 16;
+/// Most drop shadows a [`PaintedText`] carries.
+pub const PAINTED_TEXT_MAX_SHADOWS: usize = 8;
+/// Most stroke rings a [`PaintedText`] carries.
+pub const PAINTED_TEXT_MAX_RINGS: usize = 8;
+
+/// No fill; the layer is skipped.
+pub const PAINTED_TEXT_LAYER_NONE: u32 = 0;
+/// A solid color, `solid` premultiplied with the layer opacity applied.
+pub const PAINTED_TEXT_LAYER_SOLID: u32 = 1;
+/// A linear gradient; `params` = direction x, direction y, min projection, span.
+pub const PAINTED_TEXT_LAYER_LINEAR: u32 = 2;
+/// A circular radial gradient; `params` = center x, center y, radius.
+pub const PAINTED_TEXT_LAYER_CIRCLE: u32 = 3;
+/// An elliptical radial gradient; `params` = center x, center y, radius x, radius y.
+pub const PAINTED_TEXT_LAYER_ELLIPSE: u32 = 4;
+/// The fill texture stretched over the paint box, over the base color.
+pub const PAINTED_TEXT_LAYER_IMAGE: u32 = 5;
+
+/// One fill layer of a [`PaintedText`].
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+#[repr(C)]
+#[expect(missing_docs)]
