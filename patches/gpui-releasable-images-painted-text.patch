+    /// Create a single-frame image whose CPU pixels are released once a window
+    /// has uploaded them to its sprite atlas.
+    ///
+    /// Local Echo extension (`echo-paint-fork`). Atlases are per window and are
+    /// cleared when the GPU device is lost, so a window that needs the pixels
+    /// after the release calls `source` to rebuild them. `source` may return
+    /// `None` when they can no longer be rebuilt; that window then paints
+    /// nothing for the image.
+    pub fn new_releasable(
+        width: u32,
+        height: u32,
+        delay: Delay,
+        pixels: Vec<u8>,
+        source: RenderImagePixelSource,
+    ) -> Self {
+        Self {
+            id: next_image_id(),
+            scale_factor: 1.0,
+            data: SmallVec::new(),
+            releasable: Some(ReleasablePixels {
+                size: size(width.into(), height.into()),
+                delay,
+                resident: Mutex::new(Some(pixels)),
+                source,
+            }),
         }
     }
 
     /// Convert this image into a byte slice.
+    ///
+    /// Always `None` for an image created with [`Self::new_releasable`]; use
+    /// [`Self::with_pixels`] to read those.
     pub fn as_bytes(&self, frame_index: usize) -> Option<&[u8]> {
         self.data
             .get(frame_index)
             .map(|frame| frame.buffer().as_raw().as_slice())
     }
 
+    /// Run `f` on a frame's BGRA pixels: borrowed, still resident, or rebuilt
+    /// for a released image. `None` when the frame has no pixels.
+    pub fn with_pixels<R>(&self, frame_index: usize, f: impl FnOnce(&[u8]) -> R) -> Option<R> {
+        if let Some(bytes) = self.as_bytes(frame_index) {
+            return Some(f(bytes));
+        }
+        let releasable = self.releasable.as_ref().filter(|_| frame_index == 0)?;
+        {
+            let resident = releasable.resident.lock();
+            if let Some(bytes) = resident.as_deref() {
+                return Some(f(bytes));
+            }
+        }
+        let bytes = (releasable.source)()?;
+        Some(f(&bytes))
+    }
+
+    /// Size in bytes of a frame's BGRA pixels, whether or not they are resident.
+    pub fn byte_len(&self, frame_index: usize) -> usize {
+        let size = self.size(frame_index);
+        size.width.0.max(0) as usize * size.height.0.max(0) as usize * 4
+    }
+
+    /// Whether this image drops its CPU pixels after an atlas upload.
+    pub fn is_releasable(&self) -> bool {
+        self.releasable.is_some()
+    }
+
+    /// Whether a released image still holds its CPU pixels.
+    pub fn has_resident_pixels(&self) -> bool {
+        self.releasable
+            .as_ref()
+            .is_none_or(|releasable| releasable.resident.lock().is_some())
+    }
+
+    /// Lock a releasable image's resident pixels so an atlas upload can borrow
+    /// them. `None` for other images.
+    pub(crate) fn lock_resident_pixels(&self) -> Option<MutexGuard<'_, Option<Vec<u8>>>> {
+        self.releasable
+            .as_ref()
+            .map(|releasable| releasable.resident.lock())
+    }
+
+    /// Rebuild a released frame's pixels.
+    pub(crate) fn rebuild_pixels(&self, frame_index: usize) -> Option<Vec<u8>> {
+        let releasable = self.releasable.as_ref().filter(|_| frame_index == 0)?;
+        (releasable.source)()
+    }
+
+    /// Drop a releasable image's CPU pixels; a no-op for other images.
+    pub(crate) fn release_pixels(&self) {
+        if let Some(releasable) = &self.releasable {
+            releasable.resident.lock().take();
+        }
+    }
