+    /// Present/swap-chain timing for the most recently scanned-out frame, mapped from
+    /// `IDXGISwapChain::GetFrameStatistics` and the high-resolution performance counter.
+    ///
+    /// Local Echo extension (branch `echo-paint-fork`) for the in-app metrics overlay.
+    /// `GetFrameStatistics` is meaningful only on flip-model swap chains (this backend
+    /// uses `DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL`). Returns `None` when no statistics are
+    /// available yet, when DXGI reports the data is transiently disjoint, or when the
+    /// performance counter is unusable. Never fabricates values.
+    pub(crate) fn present_statistics(&self) -> Option<PresentStatistics> {
+        use windows::Win32::System::Performance::{
+            QueryPerformanceCounter, QueryPerformanceFrequency,
+        };
+
+        let resources = self.resources.as_ref()?;
+        let mut stats = DXGI_FRAME_STATISTICS::default();
+        // SAFETY: `stats` is a valid, fully-owned out-param for the duration of the call.
+        // GetFrameStatistics returns an HRESULT; any failure (most notably
+        // DXGI_ERROR_FRAME_STATISTICS_DISJOINT, which means the data is momentarily
+        // inconsistent, e.g. just after a mode change) is treated as "not available right
+        // now" rather than an error.
+        let hr = unsafe { resources.swap_chain.GetFrameStatistics(&mut stats) };
+        if hr.is_err() {
+            return None;
+        }
+
+        // SyncQPCTime is the QPC value at the vsync that scanned out the last present.
+        // Zero means the swap chain has not produced a vsync-aligned present yet
+        // (common right after startup, or when presenting with sync interval 0 before
+        // the compositor has sampled a frame): no honest latency can be derived.
+        let sync_qpc = stats.SyncQPCTime;
+        if sync_qpc == 0 {
+            return None;
+        }
+
+        let mut now_qpc: i64 = 0;
+        let mut freq: i64 = 0;
+        // SAFETY: both out-params are valid local i64 storage.
+        unsafe {
+            QueryPerformanceCounter(&mut now_qpc).ok()?;
+            QueryPerformanceFrequency(&mut freq).ok()?;
+        }
+        if freq <= 0 {
+            return None;
+        }
+
+        // Age of the most recently presented frame, in milliseconds. Clamp to >= 0 in
+        // case the swap chain reports a SyncQPCTime fractionally ahead of `now`.
+        let delta_ticks = (now_qpc - sync_qpc).max(0);
+        let present_latency_ms = (delta_ticks as f64) * 1000.0 / (freq as f64);
+
+        Some(PresentStatistics {
+            present_count: stats.PresentCount,
+            present_latency_ms,
+        })
+    }
