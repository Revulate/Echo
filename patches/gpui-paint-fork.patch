From: Revulate <76570121+Revulate@users.noreply.github.com>
Date: Tue, 9 Jun 2026 20:59:16 -0700
Subject: [PATCH 1/2] gpui: add Window::rasterize_shaped_line_mask for Echo
 exact 7TV paints

Expose a position-independent grayscale glyph-coverage mask for (a byte
subrange of) a ShapedLine. Echo composites exact 7TV name-paint fills
(linear/radial/repeating gradients, image textures) and gaussian-blurred
glyph-shaped shadows on the CPU, caches the flattened result, and paints
it as a regular image sprite.

Rasterization has to live inside GPUI because raster_bounds/
rasterize_glyph and RenderGlyphParams are pub(crate).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 crates/gpui/src/window.rs | 177 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 177 insertions(+)

diff --git a/crates/gpui/src/window.rs b/crates/gpui/src/window.rs
index 4e2e1a798c..bc28904619 100644
--- a/crates/gpui/src/window.rs
+++ b/crates/gpui/src/window.rs
@@ -5146,6 +5146,164 @@ impl Window {
         Ok(())
     }
 
+    /// Rasterize the grayscale glyph-coverage mask for `line` at the window's current
+    /// scale factor.
+    ///
+    /// This is a local Echo extension (branch `echo-paint-fork`) used for exact 7TV
+    /// name-paint rendering: the caller generates its own gradient/image fill and
+    /// blurred shadow layers on the CPU, masks them with this coverage buffer, caches
+    /// the flattened result as a [`RenderImage`], and paints it via
+    /// [`Window::paint_image`]. Only coverage extraction lives in GPUI because glyph
+    /// rasterization requires `pub(crate)` text-system internals.
+    ///
+    /// `byte_range` optionally restricts the mask to glyphs whose source byte index
+    /// falls inside the range (e.g. a username inside a larger shaped line).
+    ///
+    /// Glyph origins are quantized to whole device pixels (no subpixel variants), so
+    /// the mask is position-independent and can be cached and repainted at any origin.
+    /// Returns `Ok(None)` when no rasterizable glyph coverage exists.
+    pub fn rasterize_shaped_line_mask(
+        &mut self,
+        line: &crate::ShapedLine,
+        line_height: Pixels,
+        byte_range: Option<std::ops::Range<usize>>,
+    ) -> Result<Option<ShapedLineRasterMask>> {
+        struct GlyphCoverage {
+            dst_x0: i32,
+            dst_y0: i32,
+            width: usize,
+            height: usize,
+            channels: usize,
+            bytes: Vec<u8>,
+        }
+
+        let scale_factor = self.scale_factor();
+        let layout = &line.layout;
+        let padding_top = (line_height - layout.ascent - layout.descent) / 2.0;
+        let baseline_y = padding_top + layout.ascent;
+
+        let mut glyph_masks: Vec<GlyphCoverage> = Vec::with_capacity(layout.len.max(8));
+        let mut min_x = i32::MAX;
+        let mut min_y = i32::MAX;
+        let mut max_x = i32::MIN;
+        let mut max_y = i32::MIN;
+
+        for run in &layout.runs {
+            for glyph in &run.glyphs {
+                if let Some(range) = byte_range.as_ref() {
+                    if !range.contains(&glyph.index) {
+                        continue;
+                    }
+                }
+
+                let logical_origin = point(glyph.position.x, baseline_y + glyph.position.y);
+                let origin_scaled = logical_origin.scale(scale_factor);
+
+                // Quantize to whole device pixels so the mask does not depend on the
+                // eventual paint origin and can be cached across frames/positions.
+                let params = RenderGlyphParams {
+                    font_id: run.font_id,
+                    glyph_id: glyph.id,
+                    font_size: layout.font_size,
+                    subpixel_variant: Point::new(0, 0),
+                    scale_factor,
+                    is_emoji: false,
+                    subpixel_rendering: false,
+                    dilation: 0,
+                };
+
+                let raster_bounds = self.text_system().raster_bounds(&params)?;
+                if raster_bounds.is_zero() {
+                    continue;
+                }
+
+                let (mask_size, bytes) = self.text_system().rasterize_glyph(&params)?;
+                let width = mask_size.width.0.max(0) as usize;
+                let height = mask_size.height.0.max(0) as usize;
+                if width == 0 || height == 0 {
+                    continue;
+                }
+                let pixel_count = width * height;
+                if bytes.len() < pixel_count {
+                    continue;
+                }
+                let channels = bytes.len() / pixel_count;
+
+                let dst_x0 = origin_scaled.x.0.floor() as i32 + raster_bounds.origin.x.0;
+                let dst_y0 = origin_scaled.y.0.floor() as i32 + raster_bounds.origin.y.0;
+
+                min_x = min_x.min(dst_x0);
+                min_y = min_y.min(dst_y0);
+                max_x = max_x.max(dst_x0 + width as i32);
+                max_y = max_y.max(dst_y0 + height as i32);
+
+                glyph_masks.push(GlyphCoverage {
+                    dst_x0,
+                    dst_y0,
+                    width,
+                    height,
+                    channels,
+                    bytes,
+                });
+            }
+        }
+
+        if glyph_masks.is_empty() || min_x >= max_x || min_y >= max_y {
+            return Ok(None);
+        }
+
+        let mask_w = (max_x - min_x) as usize;
+        let mask_h = (max_y - min_y) as usize;
+        let mut coverage = vec![0u8; mask_w * mask_h];
+
+        for glyph in &glyph_masks {
+            for y in 0..glyph.height {
+                let src_row = y * glyph.width;
+                let dst_y = (glyph.dst_y0 - min_y) as usize + y;
+                let dst_row = dst_y * mask_w;
+                for x in 0..glyph.width {
+                    let pixel_i = src_row + x;
+                    let alpha = match glyph.channels {
+                        1 => glyph.bytes[pixel_i],
+                        3 => {
+                            let i = pixel_i * 3;
+                            glyph.bytes[i].max(glyph.bytes[i + 1]).max(glyph.bytes[i + 2])
+                        }
+                        channels => {
+                            let i = pixel_i * channels;
+                            let a = glyph.bytes.get(i + 3).copied().unwrap_or(0);
+                            if a > 0 {
+                                a
+                            } else {
+                                let r = glyph.bytes.get(i).copied().unwrap_or(0);
+                                let g = glyph.bytes.get(i + 1).copied().unwrap_or(0);
+                                let b = glyph.bytes.get(i + 2).copied().unwrap_or(0);
+                                r.max(g).max(b)
+                            }
+                        }
+                    };
+                    if alpha == 0 {
+                        continue;
+                    }
+
+                    let dst_x = (glyph.dst_x0 - min_x) as usize + x;
+                    let out = &mut coverage[dst_row + dst_x];
+                    *out = (*out).max(alpha);
+                }
+            }
+        }
+
+        Ok(Some(ShapedLineRasterMask {
+            coverage,
+            size: size(DevicePixels(mask_w as i32), DevicePixels(mask_h as i32)),
+            origin_offset: point(
+                Pixels(min_x as f32 / scale_factor),
+                Pixels(min_y as f32 / scale_factor),
+            ),
+            scale_factor,
+        }))
+    }
+
     fn should_use_subpixel_rendering(&self, font_id: FontId, font_size: Pixels) -> bool {
         if self.platform_window.background_appearance() != WindowBackgroundAppearance::Opaque {
             return false;
@@ -8163,6 +8321,25 @@ fn with_element_arena_erased(callback: &mut dyn FnMut(&mut Arena)) -> Result<(),
     }
 }
 
+/// A rasterized grayscale glyph-coverage mask for (a subrange of) a
+/// [`ShapedLine`](crate::ShapedLine), produced by
+/// [`Window::rasterize_shaped_line_mask`].
+///
+/// Local Echo extension (branch `echo-paint-fork`); see that method for details.
+#[derive(Clone, Debug)]
+pub struct ShapedLineRasterMask {
+    /// One coverage byte per pixel, row-major, `size.width * size.height` entries.
+    pub coverage: Vec<u8>,
+    /// Mask dimensions in device pixels.
+    pub size: Size<DevicePixels>,
+    /// Offset from the line's logical paint origin (top-left of the line box) to the
+    /// mask's top-left corner, in logical pixels. May be negative for overhanging
+    /// glyphs.
+    pub origin_offset: Point<Pixels>,
+    /// The window scale factor the mask was rasterized at.
+    pub scale_factor: f32,
+}
+
