+/// Present/swap-chain timing for the most recently scanned-out frame.
+///
+/// This is a local Echo extension (branch `echo-paint-fork`) used by the in-app
+/// metrics overlay. On Windows it maps `IDXGISwapChain::GetFrameStatistics` (a
+/// flip-model swap chain is required); other platforms return `None`. Values come
+/// straight from DXGI/QPC and are never fabricated: when statistics are unavailable
+/// or transiently disjoint, [`Window::present_statistics`] returns `None`.
+#[derive(Debug, Clone, Copy)]
+pub struct PresentStatistics {
+    /// Running count of frames the swap chain has presented (DXGI `PresentCount`).
+    pub present_count: u32,
+    /// Age, in milliseconds, of the most recently presented frame: the elapsed time
+    /// between that frame's vsync scan-out (`SyncQPCTime`) and the moment this call
+    /// sampled the high-resolution counter. Approximates present-pipeline latency.
+    pub present_latency_ms: f64,
+}
